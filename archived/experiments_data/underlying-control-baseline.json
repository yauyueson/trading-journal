{
  "name": "underlying-control-baseline",
  "description": "Canonical stock-first control baseline: full 14-ticker universe, pb8 vs pb21 as separate competing candidates, maxPositions=3, no blending, no regime router, no extra entry filters.",
  "strategy": "underlying",
  "tickers": ["SPY", "QQQ", "AMD", "IWM", "TSLA", "AAPL", "JPM", "NVDA", "AMZN", "MSFT", "META", "NFLX", "GOOG", "GS"],
  "maxPositions": 3,
  "maxPerTicker": 1,
  "fixedNotional": 10000,
  "fillMode": "bidask",
  "presets": ["pb8", "pb21"],
  "sweepOverrides": {
    "presets": ["pb8", "pb21"],
    "underlyingSignalBundles": [["pb8"], ["pb21"]],
    "underlyingPb21RouterModes": ["off"],
    "underlyingPb21RankingBonuses": [0],
    "underlyingMaxPositions": [3],
    "underlyingExitEMAs": [21, 34],
    "underlyingExitConfirmDays": [1, 2],
    "underlyingExitRequireSlope": [true],
    "underlyingMaxHoldDays": [15, 20]
  }
}
