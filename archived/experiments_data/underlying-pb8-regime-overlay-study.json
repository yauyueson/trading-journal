{
  "name": "underlying-pb8-regime-overlay-study",
  "description": "Full-universe stock-only overlay study: keep pb8/pb21 as separate candidates, add narrow ex-ante regime filters (VRP percentile and contango percentile) to see if pb8 mid-cycle drawdown can be reduced without damaging edge.",
  "strategy": "underlying",
  "tickers": ["SPY", "QQQ", "AMD", "IWM", "TSLA", "AAPL", "JPM", "NVDA", "AMZN", "MSFT", "META", "NFLX", "GOOG", "GS"],
  "maxPositions": 3,
  "maxPerTicker": 1,
  "fixedNotional": 10000,
  "fillMode": "bidask",
  "presets": ["pb8", "pb21"],
  "sweepOverrides": {
    "presets": ["pb8", "pb21"],
    "underlyingSignalBundles": [["pb8"], ["pb21"]],
    "underlyingPb21RouterModes": ["off"],
    "underlyingPb21RankingBonuses": [0],
    "underlyingMaxPositions": [3],
    "underlyingExitEMAs": [21, 34],
    "underlyingExitConfirmDays": [1, 2],
    "underlyingExitRequireSlope": [true],
    "underlyingMaxHoldDays": [15, 20],
    "underlyingMinEntryVrpPcts": [0, 50, 60],
    "underlyingMaxEntryContangoPcts": [50, 60, 100]
  }
}
