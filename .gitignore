# Claude Code per-machine / per-session state. The IDE auto-appends Bash
# approvals and other ephemeral tool-use permissions to settings.local.json
# during a session; tracking the file would let those leak into the repo.
# The shared counterpart `.claude/settings.json` stays committed for team
# configuration. `scheduled_tasks.lock` is a runtime lock file, never
# meaningful across sessions.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Autoresearch runner state. The trial ledger is runtime audit state
# (Phase 0.b.7 provenance), not tracked research artifact. The runner lock
# is held during a run; its presence makes `git status --porcelain` non-empty
# which would poison repoGitSha=null and render the run's rows unsealable.
data/trial-ledger/
data/autoresearch-runner.lock
scripts/autoresearch/leaderboard-*.json
