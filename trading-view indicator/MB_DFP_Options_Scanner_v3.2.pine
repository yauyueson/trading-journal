//@version=6
// © MB+DFP + Options Scanner v3.2
// v3.2: Direction-aware scoring, ATR-normalized momentum, 7-component composite
// Calibrated for 1.5wk–2mo swing options holding period

indicator("MB+DFP + Options Scanner v3.2", shorttitle="MBDFP v3.2", overlay=true, max_bars_back=1500, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==========================================
// 1. VISUAL INDICATOR INPUTS
// ==========================================
mbGR = "Visuals: Market Bias"
ha_htf  = input.timeframe('', 'Timeframe', tooltip="Must be >= chart timeframe", group=mbGR, display=display.data_window)
ha_len  = input.int(20, 'Period',    group=mbGR, display=display.data_window)
ha_len2 = input.int(7, 'Smoothing', group=mbGR, display=display.data_window)
osc_len = input.int(7, "Oscillator Period", group=mbGR, display=display.data_window)
show_ha = input.bool(true,  "Show HA Candles",   inline='ha/mb display', group=mbGR, display=display.data_window)
show_mb = input.bool(true,  "Show Market Bias",   inline='ha/mb display', group=mbGR, display=display.data_window)
col_bull = input.color(color.lime, 'Color: Bullish', inline='bull/bear color', group=mbGR, display=display.data_window)
col_bear = input.color(color.red,  'Bearish',         inline='bull/bear color', group=mbGR, display=display.data_window)

emaGR    = "Visuals: EMA Stack"
show_stack = input.bool(true,         "Show EMA Stack", group=emaGR, display=display.data_window)
ema_len1  = input.int(8,  "EMA 1 Length", group=emaGR, display=display.data_window)
ema_len2  = input.int(21, "EMA 2 Length", group=emaGR, display=display.data_window)
ema_len3  = input.int(34, "EMA 3 Length", group=emaGR, display=display.data_window)
c_ema1    = input.color(color.yellow, "EMA 1 Color",    group=emaGR, display=display.data_window)
c_ema2    = input.color(color.orange, "EMA 2 Color",   group=emaGR, display=display.data_window)
c_ema3    = input.color(color.red,    "EMA 3 Color",   group=emaGR, display=display.data_window)



dfGR   = "Visuals: Delta Flow"
dfDist = input.int(0,  'Distance from Price', minval=-100, maxval=100, step=1, group=dfGR, display=display.data_window)
vpSH   = input.bool(true, 'Money Flow Profile', inline='mfp', group=dfGR, display=display.data_window)
mfpC   = input.color(color.new(#5288C4, 0), '', inline='mfp', group=dfGR, display=display.data_window)
npSH   = input.bool(true, 'Normalized', inline='mfp', group=dfGR, display=display.data_window)
spSH   = input.bool(true, 'Delta Profile', group=dfGR, display=display.data_window)
spPTY  = input.string('Bar Polarity', 'Polarity Method', options=['Bar Polarity', 'Bar Buying/Selling Pressure'], inline='pm', group=dfGR, display=display.data_window)
spBLC  = input.color(color.new(#5288C4, 0), '', inline='pm', group=dfGR, display=display.data_window)
spBRC  = input.color(color.new(#f7525f, 0), '', inline='pm', group=dfGR, display=display.data_window)
rpLN   = input.int(360, 'Lookback Length',         minval=10, maxval=1500, step=10,  group=dfGR, display=display.data_window)
rpNR   = input.int(25,  'Number of Rows',           minval=10, maxval=125,  step=5,   group=dfGR, display=display.data_window)
rpW    = input.int(17,  'Profile Width %',           minval=10, maxval=50,             group=dfGR, display=display.data_window) / 100
vpHO   = input.int(13,  'Profile Horizontal Offset',                                   group=dfGR, display=display.data_window)
vpLS   = input.string('Tiny',  'Profile Text',  options=['Auto','Tiny','Small','None'], group=dfGR, display=display.data_window)
vpLC   = input.bool(false, 'Currency', group=dfGR, display=display.data_window)
rpPL   = input.bool(false, 'Profile Price Levels', group=dfGR, display=display.data_window)
rpLS   = input.string('Small', 'Level Text Size', options=['Tiny','Small','Normal'],    group=dfGR, display=display.data_window)

// ==========================================
// 2. SCANNER INPUTS
// ==========================================
scanGR          = "Scanner: Settings"
show_scanner    = input.bool(true, "Show Scanner Table", group=scanGR, display=display.data_window)
watchlist_input = input.string("AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,AMD,NFLX,CRM,ORCL,INTC,QCOM,AVGO,JPM,BAC,GS,MS,V,COST,SPY,QQQ,MSTR,COIN,PLTR", "Watchlist (max 25)", group=scanGR, display=display.data_window)
max_display     = input.int(15, "Max Stocks to Display", minval=5, maxval=40, group=scanGR, display=display.data_window)
min_score       = input.int(60, "Minimum Score", minval=0, maxval=100, group=scanGR, display=display.data_window)
show_puts       = input.bool(true, "Show PUT Opportunities",  group=scanGR, display=display.data_window)
show_calls      = input.bool(true, "Show CALL Opportunities", group=scanGR, display=display.data_window)
table_position  = input.string("middle_right", "Table Position", options=["top_left","top_center","top_right","middle_left","middle_center","middle_right","bottom_left","bottom_center","bottom_right"], group=scanGR, display=display.data_window)
table_size      = input.string("small", "Table Size", options=["tiny","small","normal","large"], group=scanGR, display=display.data_window)

critGR      = "Scanner: Criteria Periods"
// [v3.2] Scanner MB now shares ha_len from "Visuals: Market Bias → Period"
// so you only set one value — visual and scanner always stay in sync.
sc_mb_len   = ha_len
sc_mb_len2  = ha_len2
sc_mb_len3  = osc_len
sc_bx_s1    = input.int(5,   "B-Xtrender Short L1",   group=critGR, display=display.data_window)
sc_bx_s2    = input.int(20,  "B-Xtrender Short L2",   group=critGR, display=display.data_window)
sc_bx_s3    = input.int(15,  "B-Xtrender Short L3",   group=critGR, display=display.data_window)
sc_bx_l1    = input.int(20,  "B-Xtrender Long L1",    group=critGR, display=display.data_window)
sc_bx_l2    = input.int(15,  "B-Xtrender Long L2",    group=critGR, display=display.data_window)

// ==========================================
// ENHANCEMENT INPUTS (v2 + v3 + v3.1)
// ==========================================

// [1] RVOL
rvolGR          = "Scanner: [v2] Volume Confirmation (RVOL)"
use_rvol        = input.bool(true,  "Enable RVOL Filter",                    group=rvolGR, display=display.data_window)
rvol_period     = input.int(20,     "RVOL Average Period",    minval=5, maxval=50, group=rvolGR, display=display.data_window)
rvol_threshold  = input.float(1.3,  "Min RVOL (2-bar avg) for Full Credit",  group=rvolGR, display=display.data_window)
// rvol_penalty removed in v3.2 — RVOL is now a scored component, not a post-hoc penalty

// [2] ADX Dynamic Weighting
adxGR           = "Scanner: [v2] ADX Dynamic Weighting"
use_adx         = input.bool(true, "Enable ADX Dynamic Weights",                  group=adxGR, display=display.data_window)
adx_period      = input.int(14,    "ADX Period",   minval=5, maxval=30,             group=adxGR, display=display.data_window)
adx_trend_thresh = input.int(25,   "ADX Trend Threshold (> = Trending)",           group=adxGR, display=display.data_window)
adx_range_thresh = input.int(20,   "ADX Range Threshold (< = Ranging)",            group=adxGR, display=display.data_window)

// [v3.3] Options Specific DTE & Earnings Logic
earningGR       = "Scanner: [v3.3] Earnings & Setup Constraints"
use_earn        = input.bool(true,  "Avoid Credit/Debit ahead of Earnings",       group=earningGR, display=display.data_window)
earn_thresh     = input.int(15,     "Days to Earnings Risk Window", minval=1, maxval=21, group=earningGR, display=display.data_window)
pb_rvol_max     = input.float(0.8,  "Max RVOL for a Healthy Pullback",            group=earningGR, display=display.data_window)

// [3] Mean Reversion Filter
mrGR            = "Scanner: [v2] Mean Reversion Filter"
use_mr_filter   = input.bool(true,  "Enable Mean Reversion Filter",               group=mrGR, display=display.data_window)
mr_stddev_mult  = input.float(3.0,  "ATR Multiplier for OVEREXTENDED",            group=mrGR, display=display.data_window)
mr_lookback     = input.int(20,     "ATR Lookback",                               group=mrGR, display=display.data_window)

// [4] MTF Hard Constraint  [v3: Weekly replaces Daily as primary anchor]
mtfGR           = "Scanner: [v3] MTF Hard Constraint (Weekly Anchor)"
use_mtf_filter  = input.bool(true, "Enable Weekly Bias Hard Filter",               group=mtfGR, display=display.data_window)
mtf_score_floor = input.int(48,    "Min Weekly Score to Allow BUY (else Bounce)",  group=mtfGR, display=display.data_window)

// [5] Non-linear Boost
boostGR         = "Scanner: [v2] Perfect Storm Boost"
use_boost       = input.bool(true, "Enable 1.1x Boost (MB+BXS both > thresh)",   group=boostGR, display=display.data_window)
boost_mb_thresh = input.int(80,    "MB Score Threshold",                           group=boostGR, display=display.data_window)
boost_bxs_thresh = input.int(80,   "BXS Score Threshold",                          group=boostGR, display=display.data_window)


// [v3.2B] Signal Expectancy Analysis (Backtesting)
backGR          = "Signal Quality Analyzer (Backtest)"
show_backtest   = input.bool(true, "Show Signal Accuracy Table", group=backGR)
bt_pos          = input.string("bottom_right", "Table Position", options=["top_right", "top_left", "bottom_right", "bottom_left", "top_center", "bottom_center"], group=backGR)
look_fwd_0      = input.int(5, "5d Look-forward (bars)",   group=backGR)
look_fwd_1      = input.int(10, "10d Look-forward (bars)",   group=backGR)
look_fwd_2      = input.int(20, "20d Look-forward (bars)",    group=backGR)
min_score_bt    = input.int(75, "Min Score to Track Signal",  group=backGR)
min_win_move    = input.float(2.0, "Min Move % to Count as Win (DEPRECATED)", minval=0.0, maxval=10.0, step=0.5, group=backGR, tooltip="⚠️ Deprecated: Use ATR-based threshold below for fair cross-ticker comparison")
min_win_atr     = input.float(1.0, "Min ATR Multiple to Win", minval=0.0, maxval=5.0, step=0.1, group=backGR, tooltip="ATR-normalized win threshold: 1.0 = price must move 1× ATR in correct direction. Fair across all volatility regimes. Set to 0 to disable.")
show_regime_ctx = input.bool(false, "Show Regime Context (Trend/Range)", group=backGR, tooltip="Display tier performance split by market regime")
setup_filt_bt   = input.string("All", "Setup Filter", options=["All", "Perfect Storm", "Breakout", "Breakdown", "Pullback Buy", "Failed Rally", "Divergence", "Distribution", "Strong Trend", "Strong Down", "Directional", "Bullish", "Bearish"], group=backGR)
bt_filt_wait    = input.bool(true, "BT Filt: Wait (⏳ ADX/Range)", group=backGR)
bt_filt_overext = input.bool(true, "BT Filt: Overextended (⚠️)", group=backGR)
bt_filt_pb_ext  = input.bool(false, "BT Filt: Chasing EMA-8 (⏳PB) — skip EXTENDED entries", group=backGR, tooltip="Exclude signals where price is >1.5% past EMA-8 in chase direction. OFF by default — enable to isolate how EXTENDED entries hurt win rate vs. ideal entries.")
bt_filt_mtf     = input.bool(true, "BT Filt: MTF Conflict (⬆️)", group=backGR)
max_bt_years    = input.int(10, "Max Backtest Limit (Years)", minval=1, maxval=25, group=backGR, tooltip="Limits the backtest sample to modern market conditions, preventing 20-year old data from skewing recent performance.")

// TP/SL Simulation
tpslGR         = "Signal Quality Analyzer (TP/SL/Time Simulation)"
use_tpsl       = input.bool(true,  "Enable TP/SL Simulation Row", group=tpslGR)
show_tpsl_cmp  = input.bool(true,  "Show TP/SL vs 14d Comparison", group=tpslGR, tooltip="Show indicator (✓/↓) comparing TP/SL win rate vs 14d hold")
tp_atr         = input.float(2.0,  "Take Profit (ATR Multiplier)", minval=0.5, maxval=10.0, step=0.5, group=tpslGR)
sl_atr         = input.float(1.0,  "Stop Loss (ATR Multiplier)",   minval=0.5, maxval=10.0, step=0.5, group=tpslGR)
time_stop_bars = input.int(21, "Time Stop (Max Hold Bars)", minval=5, maxval=200, step=1, group=tpslGR, tooltip="v3 (Daily chart): 21 bars ≈ 21 trading days. v4 (4H chart): 21 bars = ~3 trading days — set to 35 for 21 trading days (2 bars/day × ~17 US-hours-market days).")

// Base Weights (7 components: signal strength × tradability)
w_mb  = input.int(25, "Weight: Market Bias %",      minval=0, maxval=40, group="Scanner: Scoring", display=display.data_window)
w_bxs = input.int(20, "Weight: B-Xtrender Short %", minval=0, maxval=40, group="Scanner: Scoring", display=display.data_window)
w_bxl = input.int(15, "Weight: B-Xtrender Long %",  minval=0, maxval=40, group="Scanner: Scoring", display=display.data_window)
w_ema = input.int(12, "Weight: EMA Stack %",        minval=0, maxval=40, group="Scanner: Scoring", display=display.data_window)
w_mom = input.int(8,  "Weight: Momentum %",         minval=0, maxval=40, group="Scanner: Scoring", display=display.data_window)
w_adx = input.int(12, "Weight: ADX Regime %",       minval=0, maxval=30, group="Scanner: Scoring", display=display.data_window)
w_vol = input.int(8,  "Weight: RVOL %",             minval=0, maxval=30, group="Scanner: Scoring", display=display.data_window)

// [v4.0] 4-Factor Hierarchical Scoring A/B Toggle
// NOTE: v4 requires the chart to be set to 4H timeframe. Daily + Weekly data
//       are fetched via request.security(). Reduce watchlist to ≤13 symbols in v4 mode
//       to stay within TradingView's ~40 unique security-call budget (13×3=39).
use_v4_scoring = input.bool(false, "Use v4 Factor Scoring (4H Chart Required)", group="Scanner: Scoring", display=display.data_window, tooltip="v4: 4-Factor hierarchical model (Trend×Structure×EntryQuality×Volume). Requires 4H chart + ≤13 symbols. v3: Legacy 7-component daily model.")

// ==========================================
// 3. VISUAL CALCULATIONS
// ==========================================
indexHighTF = timeframe.in_seconds(ha_htf) == timeframe.in_seconds('') ? 0 : barstate.isrealtime ? 1 : 0
indexCurrTF = timeframe.in_seconds(ha_htf) == timeframe.in_seconds('') ? 0 : barstate.isrealtime ? 0 : 1

f_no_repaint_request(string _resolution, _expression) =>
    request.security(syminfo.tickerid, _resolution, _expression[indexHighTF])[indexCurrTF]

f_gTxtSz(_t) =>
    switch _t
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        => size.auto

f_drawLabelX(_x, _y, _text, _style, _textcolor, _size, _tooltip) =>
    var lb = label.new(_x, _y, _text, xloc.bar_index, yloc.price, color(na), _style, _textcolor, _size, text.align_left, _tooltip)
    lb.set_xy(_x, _y), lb.set_text(_text), lb.set_tooltip(_tooltip), lb.set_textcolor(_textcolor)

// EMA Stack
v_ema1  = ta.ema(close, ema_len1)
v_ema2  = ta.ema(close, ema_len2)
v_ema3  = ta.ema(close, ema_len3)
plot(show_stack ? v_ema1  : na, "EMA 1",  color=c_ema1,  linewidth=2)
plot(show_stack ? v_ema2  : na, "EMA 2",  color=c_ema2, linewidth=2)
plot(show_stack ? v_ema3  : na, "EMA 3",  color=c_ema3, linewidth=2)



// Market Bias Visuals
mb_o = ta.ema(open, ha_len), mb_c = ta.ema(close, ha_len), mb_h = ta.ema(high, ha_len), mb_l = ta.ema(low, ha_len)
haclose  = f_no_repaint_request(ha_htf, (mb_o + mb_h + mb_l + mb_c) / 4)
xhaopen  = f_no_repaint_request(ha_htf, (mb_o + mb_c) / 2)
haopen   = na(xhaopen[1]) ? (mb_o + mb_c) / 2 : (xhaopen[1] + haclose[1]) / 2
hahigh   = math.max(mb_h, math.max(haopen, haclose))
halow    = math.min(mb_l, math.min(haopen, haclose))
o2 = f_no_repaint_request(ha_htf, ta.ema(haopen,  ha_len2))
c2 = f_no_repaint_request(ha_htf, ta.ema(haclose, ha_len2))
h2 = f_no_repaint_request(ha_htf, ta.ema(hahigh,  ha_len2))
l2 = f_no_repaint_request(ha_htf, ta.ema(halow,   ha_len2))
osc_bias   = 100 * (c2 - o2)
osc_smooth = ta.ema(osc_bias, osc_len)
sigcolor   = switch
    (osc_bias > 0) and (osc_bias >= osc_smooth) => color.new(col_bull, 35)
    (osc_bias > 0) and (osc_bias < osc_smooth)  => color.new(col_bull, 75)
    (osc_bias < 0) and (osc_bias <= osc_smooth) => color.new(col_bear, 35)
    (osc_bias < 0) and (osc_bias > osc_smooth)  => color.new(col_bear, 75)
    => color(na)
p_h = plot(h2, "Bias High", color=color(na), display=display.data_window, editable=false)
p_l = plot(l2, "Bias Low",  color=color(na), display=display.data_window, editable=false)
fill(p_l, p_h, show_mb ? sigcolor : na)
plotcandle(o2, h2, l2, c2, title='heikin smoothed', color=o2 > c2 ? col_bear : col_bull, display=show_ha ? display.pane : display.data_window, editable=false)

// Delta Flow Profile
type bar
    float o = open
    float h = high
    float l = low
    float c = close
    float v = volume
    int   i = bar_index

bar b    = bar.new()
nzV      = nz(b.v)
rpVST    = array.new<float>(rpNR, 0.)
rpVSB    = array.new<float>(rpNR, 0.)
rpVSD    = array.new<float>(rpNR, 0.)
var dRP  = array.new<box>()
var dPR  = array.new<line>()
var float pLST = na, var float pHST = na, var int sI = na, var color llC = na
bull = spPTY == 'Bar Polarity' ? b.c > b.o : (b.c - b.l) > (b.h - b.c)
rpS  = f_gTxtSz(rpLS), vpS = f_gTxtSz(vpLS)
adj_rpLN = last_bar_index > rpLN ? rpLN - 1 : last_bar_index
if b.i == last_bar_index - adj_rpLN
    sI   := b.i, pLST := b.l, pHST := b.h
else if b.i > last_bar_index - adj_rpLN
    pLST := math.min(b.l, pLST), pHST := math.max(b.h, pHST)
pSTP = (pHST - pLST) / rpNR

if barstate.islast and not na(nzV) and not timeframe.isseconds and adj_rpLN > 0 and pSTP > 0 and nzV > 0
    if dRP.size() > 0
        for i = 0 to dRP.size() - 1
            box.delete(dRP.shift())
    if dPR.size() > 0
        for i = 0 to dPR.size() - 1
            line.delete(dPR.shift())
    for bI = adj_rpLN to 0
        l_idx = 0
        _h = high[bI], _l = low[bI], _v = nzV[bI]
        for pLL = pLST to pHST - pSTP by pSTP
            if _h >= pLL and _l < pLL + pSTP
                vPOR = 0.0
                if _l >= pLL and _h > pLL + pSTP
                    vPOR := (pLL + pSTP - _l) / (_h - _l)
                else if _h <= pLL + pSTP and _l < pLL
                    vPOR := (_h - pLL) / (_h - _l)
                else if (_l >= pLL and _h <= pLL + pSTP)
                    vPOR := 1.0
                else
                    vPOR := pSTP / (_h - _l)
                rpVST.set(l_idx, rpVST.get(l_idx) + _v * vPOR * (pLST + (l_idx + .5) * pSTP))
                if bull[bI] and spSH
                    rpVSB.set(l_idx, rpVSB.get(l_idx) + _v * vPOR * (pLST + (l_idx + .5) * pSTP))
            l_idx += 1
    vtMX = rpVST.max()
    for l = 0 to rpNR - 1
        vtLV = rpVST.get(l), LpM = vtLV / vtMX, bbp = 2 * rpVSB.get(l) - vtLV
        rpVSD.set(l, rpVSD.get(l) + bbp * (bbp > 0 ? 1 : -1))
        if vpSH and npSH
            llC := color.from_gradient(LpM, 0, 1, color.new(mfpC, 93), color.new(mfpC, 53))
            sBI  = b.i + int(4 * adj_rpLN * rpW / 3) + dfDist
            dRP.push(box.new(sBI + 1 + vpHO, pLST + (l + .03) * pSTP, sBI + int(adj_rpLN * rpW / 3) + 3 + vpHO, pLST + (l + .97) * pSTP, color(na), bgcolor=llC))
            dPR.push(line.new(sBI + 1 + vpHO, pLST + (l + .0) * pSTP, sBI + int(adj_rpLN * rpW / 3) + 3 + vpHO, pLST + (l + .0) * pSTP, color=color.gray, width=2))
            sBI := sBI + int(adj_rpLN * rpW / 3) + 3 + vpHO
            eBI  = sBI - int(LpM * (int(adj_rpLN * rpW / 3) + 2))
            llC := color.from_gradient(LpM, 0, 1, color.new(mfpC, 53), color.new(chart.fg_color, 13))
            dRP.push(box.new(sBI, pLST + (l + .1) * pSTP, eBI, pLST + (l + .9) * pSTP, color(na), bgcolor=llC, text=vpLS != 'None' ? str.tostring(LpM * 100, format.percent) : '', text_color=LpM == 1 ? color.blue : LpM > .5 ? chart.bg_color : chart.fg_color, text_halign=text.align_right, text_size=LpM == 1 ? size.small : size.tiny))
    if spSH
        bbp = 2 * rpVSB.sum() - rpVST.sum()
        llC := bbp > 0 ? spBLC : spBRC
        dPR.push(line.new(sI + dfDist, pLST, sI + dfDist, pHST, color=llC, width=2))
    if vpSH
        dPR.push(line.new(b.i + int(4 * adj_rpLN * rpW / 3) + 1 + vpHO + dfDist, pLST, b.i + int(4 * adj_rpLN * rpW / 3) + 1 + vpHO + dfDist, pHST, color=mfpC, width=2))
        if npSH
            dPR.push(line.new(b.i + int(5 * adj_rpLN * rpW / 3) + 3 + vpHO + dfDist, pLST, b.i + int(5 * adj_rpLN * rpW / 3) + 3 + vpHO + dfDist, pHST, color=mfpC, width=2))
    if rpPL
        f_drawLabelX(vpSH ? b.i + int(4 * adj_rpLN * rpW / 3) + 1 + vpHO + dfDist : b.i + dfDist, pHST, 'Profile High · ' + str.tostring(pHST, format.mintick), label.style_label_down, mfpC, rpS, 'Profile High')
        f_drawLabelX(vpSH ? b.i + int(4 * adj_rpLN * rpW / 3) + 1 + vpHO + dfDist : b.i + dfDist, pLST, 'Profile Low · '  + str.tostring(pLST, format.mintick), label.style_label_up,   mfpC, rpS, 'Profile Low')
    vdMX = rpVSD.max()
    for l = 0 to rpNR - 1
        if dRP.size() < 500
            vtLV = rpVST.get(l), LpM = vtLV / vtMX, DpM = rpVSD.get(l) / vdMX
            if vpSH
                sBI  = b.i + int(4 * adj_rpLN * rpW / 3) + dfDist
                eBI  = sBI - int(LpM * adj_rpLN * rpW)
                llC := color.from_gradient(LpM, 0, 1, color.new(mfpC, 73), color.new(mfpC, 3))
                dRP.push(box.new(sBI + vpHO, pLST + (l + .1) * pSTP, eBI + vpHO, pLST + (l + .9) * pSTP, color(na), bgcolor=llC, text=(vpLS != 'None' ? str.tostring(array.get(rpVST, l), format.volume) : ''), text_halign=text.align_right, text_color=LpM == 1 ? color.yellow : chart.fg_color, text_size=vpS))
            if spSH
                sBI  = sI + dfDist, eBI = sBI + int(DpM * adj_rpLN * rpW)
                bbp  = 2 * rpVSB.get(l) - vtLV
                llC := bbp > 0 ? color.from_gradient(DpM, 0, 1, color.new(spBLC, 80), color.new(spBLC, 20)) : color.from_gradient(DpM, 0, 1, color.new(spBRC, 80), color.new(spBRC, 20))
                dRP.push(box.new(sBI + 1, pLST + (l + .1) * pSTP, eBI + 1, pLST + (l + .9) * pSTP, color(na), bgcolor=llC, text=(vpLS != 'None' ? str.tostring(bbp, format.volume) : ''), text_halign=text.align_left, text_color=chart.fg_color, text_size=vpS))


// ==========================================
// 4. SCANNER HELPER FUNCTIONS
// ==========================================

type StockData
    string symbol
    float  score
    string signal
    string setup
    string stype
    int    confidence
    float  mb_osc
    float  bx_short
    float  bx_long
    float  dist_ema1
    bool   reversal
    float  rvol
    string regime       // [FIX-5] raw regime string, no mtf_tag
    bool   overextended
    bool   mtf_conflict
    string market_state
    string note_detail
    string pb_qual      // 'EXTENDED' | 'MOMENTUM' | 'SWEET' | 'PULLBACK'

s_t3_smooth(src, len) =>
    xe1=ta.ema(src,len), xe2=ta.ema(xe1,len), xe3=ta.ema(xe2,len)
    xe4=ta.ema(xe3,len), xe5=ta.ema(xe4,len), xe6=ta.ema(xe5,len)
    t3b=0.7, c1=-t3b*t3b*t3b, c_2=3*t3b*t3b+3*t3b*t3b*t3b, c3=-6*t3b*t3b-3*t3b-3*t3b*t3b*t3b, c4=1+3*t3b+t3b*t3b*t3b+3*t3b*t3b
    c1*xe6 + c_2*xe5 + c3*xe4 + c4*xe3

s_calc_mb(c, o, h, l, len1, len2, len3) =>
    _mb_o=ta.ema(o,len1), _mb_c=ta.ema(c,len1), _mb_h=ta.ema(h,len1), _mb_l=ta.ema(l,len1)
    hc=(_mb_o+_mb_h+_mb_l+_mb_c)/4
    xho=(_mb_o+_mb_c)/2
    ho=na(xho[1])?(_mb_o+_mb_c)/2:(xho[1]+hc[1])/2
    _o2=ta.ema(ho,len2), _c2=ta.ema(hc,len2)
    osc=100*(_c2-_o2), sm=ta.ema(osc,len3)
    is_bull=osc>0, is_str=is_bull?(osc>=sm):(osc<=sm)
    bs_bull=is_bull and osc[1]<0, bs_bear=not is_bull and osc[1]>=0
    [osc,is_bull,is_str,bs_bull,bs_bear]

s_calc_bx(c, s1, s2, s3, l1, l2) =>
    stX=ta.rsi(ta.ema(c,s1)-ta.ema(c,s2),s3)-50
    ltX=ta.rsi(ta.ema(c,l1),l2)-50
    mstX=s_t3_smooth(stX,5)
    [stX, mstX, ltX, mstX>mstX[1] and mstX[1]<mstX[2], mstX<mstX[1] and mstX[1]>mstX[2], stX>0 and stX[1]<=0, stX<0 and stX[1]>=0]

// EMA periods for scanner are now synced with Visuals settings
s_calc_emas(c, l1, l2, l3) =>
    e1=ta.ema(c,l1), e2=ta.ema(c,l2), e3=ta.ema(c,l3)
    d1=(c-e1)/e1*100, d2=(c-e2)/e2*100, d3=(c-e3)/e3*100
    bstk=e1>e2 and e2>e3, brstk=e1<e2 and e2<e3
    [e1,e2,e3,d1,d2,d3,bstk,brstk,math.abs(d2)<1.0,math.abs(d3)<1.5,c>e1 and c[1]<=e1[1],c<e1 and c[1]>=e1[1]]

// ADX helper
s_calc_adx(len) =>
    up=ta.change(high), dn=-ta.change(low)
    plus=na(up)?na:(up>dn and up>0?up:0)
    minus=na(dn)?na:(dn>up and dn>0?dn:0)
    tr_=ta.rma(ta.tr,len)
    pdi=100*ta.rma(plus,len)/tr_, mdi=100*ta.rma(minus,len)/tr_
    sum_di=pdi+mdi
    adx_v=100*ta.rma(math.abs(pdi-mdi)/(sum_di==0?1:sum_di),len)
    [adx_v, pdi, mdi]

// RVOL with 2-bar confirmation
s_calc_rvol(vol, period) =>
    avg = ta.sma(vol, period)
    rvol_now  = nz(vol,0)   / (avg==0?1:avg)
    rvol_prev = nz(vol[1],0) / (nz(avg[1],avg)==0?1:nz(avg[1],avg))
    rvol_2bar = (rvol_now + rvol_prev) / 2
    [rvol_now, rvol_2bar]


// Setup Identification (v3.2B relaxed + v3.3 RVOL contraction for pullbacks)
s_identify(osc, bull, bs_bull, bs_bear, bxs, bxl, rev_up, rev_dn, crup, crdn, d1, d2, d3, bstk, brstk, t2, t3, cup1, cdn1, rvol_now, pb_max, is_sqz) =>
    name="Mixed", type="NEUTRAL", conf=0

    // ── CALL setups (strongest → weakest) ──────────────────
    if (bs_bull or (bull and osc>2)) and (crup or (bxs>0 and rev_up)) and bxl>0 and cup1 and bstk
        name:="Perfect Storm", type:="CALL", conf:=3
    else if bull and osc>2 and bxs>10 and bxl>5 and cup1 and d1>1 and d2>0
        name:=is_sqz ? "Squeeze Breakout" : "Breakout", type:="CALL", conf:=3
    else if bull and osc>2 and bxs>5 and bxl>8 and d1>0
        name:="Strong Trend", type:="CALL", conf:=2
    else if bull and osc>1 and bxs>0 and not crdn and bxl>0 and (t2 or t3) and d1>-2 and rvol_now <= pb_max and (math.abs(d1) <= 1.5 or math.abs(d3) <= 1.5)
        name:="Pullback Buy", type:="CALL", conf:=2
    else if (bs_bull or osc>0) and rev_up and bxs>-10 and cup1
        name:="Divergence", type:="CALL", conf:=1

    // ── PUT setups (strongest → weakest) ───────────────────
    else if (bs_bear or (not bull and osc<-2)) and (crdn or (bxs<0 and rev_dn)) and bxl<0 and cdn1 and brstk
        name:="Perfect Storm", type:="PUT", conf:=3
    else if not bull and osc<-2 and bxs<-10 and bxl<-5 and cdn1 and d1<-1 and d2<0
        name:=is_sqz ? "Squeeze Breakdown" : "Breakdown", type:="PUT", conf:=3
    else if not bull and osc<-2 and bxs<-5 and bxl<-8 and d1<0
        name:="Strong Down", type:="PUT", conf:=2
    else if not bull and osc<-1 and bxs<0 and not crup and bxl<0 and (t2 or t3) and d1<2 and rvol_now <= pb_max and (math.abs(d1) <= 1.5 or math.abs(d3) <= 1.5)
        name:="Failed Rally", type:="PUT", conf:=2
    else if (bs_bear or osc<0) and rev_dn and bxs<10 and cdn1
        name:="Distribution", type:="PUT", conf:=1

    // ── [v3.2B REFINED] Directional catch-all ──────────────────
    // All 3 core oscillators agree AND there is confirmed recent price progress
    else if bull and bxs>0 and bxl>0 and d1>-1 and (nz(close[3]) > 0 and close > close[3])
        name:="Directional", type:="CALL", conf:=1
    else if not bull and bxs<0 and bxl<0 and d1<1 and (nz(close[3]) > 0 and close < close[3])
        name:="Directional", type:="PUT", conf:=1

    // ── Generic fallback ───────────────────────────────────
    else
        if bull and bxs>0
            name:="Bullish", type:="CALL"
        else if not bull and bxs<0
            name:="Bearish", type:="PUT"
    [name, type, conf]

// ==========================================
// 4B. WEEKLY MTF SCORE HELPER
// ==========================================
// Legacy v3 weekly score — kept for A/B comparison via use_v4_scoring toggle.
s_calc_weekly_score(c_mb1, c_mb2, c_mb3) =>
    [wk_osc, wk_bull, wk_str, _, _] = s_calc_mb(close, open, high, low, c_mb1, c_mb2, c_mb3)
    mtf_momentum_bonus = wk_str ? (wk_bull ? 20.0 : -20.0) : (wk_bull ? 5.0 : -5.0)
    wk_score = 50.0 + (wk_bull ? math.min(wk_osc * 5, 30) : -math.min(math.abs(wk_osc) * 5, 30)) + mtf_momentum_bonus
    wk_score

// ==========================================
// 4C. V4 FACTOR FUNCTIONS (v4.0)
// ==========================================
// Replaces the 7-component flat additive model with 4 orthogonal factors.
// Factor 1 (Trend) + Factor 2 (Structure) run on DAILY via request.security().
// Factor 3 (Entry Quality) + Factor 4 (Volume) run on 4H chart natively.
// Final score = Base × Entry_Mult × Coherence × MTF_Modifier (hierarchical).

// ── Factor 1: Trend Direction ──────────────────────────────────────────────
// Collapses MB + BXS + BXL into one convergence-weighted directional score.
// dir = +1 for CALL, -1 for PUT, 0 for NEUTRAL.
s_calc_trend_factor(dir, mb, iss, bxs, bxl) =>
    mb_norm  = math.max(-1.0, math.min(1.0, mb  * dir / 5.0))
    bxs_norm = math.max(-1.0, math.min(1.0, bxs * dir / 30.0))
    bxl_norm = math.max(-1.0, math.min(1.0, bxl * dir / 25.0))

    all_aligned = mb_norm > 0 and bxs_norm > 0 and bxl_norm > 0
    convergence = all_aligned ? 1.15 : (mb_norm > 0 and bxs_norm > 0 ? 1.0 : 0.85)

    raw       = (mb_norm * 0.45 + bxs_norm * 0.35 + bxl_norm * 0.20) * convergence
    str_bonus = iss and mb_norm > 0.3 ? 0.10 : 0.0
    math.max(math.min(50.0 + (raw + str_bonus) * 100.0, 100.0), 0.0)

// ── Factor 2: Structure Quality ────────────────────────────────────────────
// EMA stack alignment + ADX regime → is the trend structurally sound?
s_calc_structure_factor(dir, d1, d2, d3, bstk, brstk, adx_v, sn) =>
    ema_aligned = (dir > 0 and bstk) or (dir < 0 and brstk)
    ema_partial = (dir > 0 and d1 > 0 and d2 > 0) or (dir < 0 and d1 < 0 and d2 < 0)

    ema_comp   = ema_aligned ? 0.40 : ema_partial ? 0.20 : (d1 * dir > 0 ? 0.05 : -0.15)
    gap_norm   = ema_aligned ? math.min(math.abs(d2) / 3.0, 1.0) * 0.10 : 0.0
    adx_comp   = adx_v > 25 ? 0.15 : adx_v > 20 ? 0.05 : -0.05
    is_strong  = sn == "Perfect Storm" or sn == "Breakout" or sn == "Breakdown" or sn == "Strong Trend" or sn == "Strong Down"
    setup_b    = is_strong ? 0.10 : 0.0

    raw = ema_comp + gap_norm + adx_comp + setup_b
    math.max(math.min(50.0 + raw * 100.0, 100.0), 0.0)

// V4 weekly HTF — called via request.security(sym, "W", s_calc_weekly_htf(...))
// Runs full Trend + Structure factors on Weekly bars, plus 8-bar trend persistence.
// Replaces the single-oscillator hard-block with a soft multiplier (0.75–1.08).
// Returns [wk_score, wk_dir]:
//   wk_score  = Trend*0.40 + Structure*0.35 + Persistence*0.25   (0–100 scale)
//   wk_dir    = +1 (bullish) | -1 (bearish) | 0 (neutral)
s_calc_weekly_htf(c_mb1, c_mb2, c_mb3, c_s1, c_s2, c_s3, c_l1, c_l2, c_e1, c_e2, c_e3) =>
    [mb, isb, iss, bsb, bss]                                     = s_calc_mb(close, open, high, low, c_mb1, c_mb2, c_mb3)
    [bxs, mabxs, bxl, rvu, rvd, cru, crd]                       = s_calc_bx(close, c_s1, c_s2, c_s3, c_l1, c_l2)
    [e1, e2, e3, d1, d2, d3, bstk, brstk, t2, t3, cup1, cdn1]   = s_calc_emas(close, c_e1, c_e2, c_e3)
    [adx_v, pdi, mdi]                                            = s_calc_adx(14)

    wk_dir    = isb and bxs > 0 ? 1.0 : (not isb and bxs < 0 ? -1.0 : 0.0)
    wk_trend  = s_calc_trend_factor(wk_dir, mb, iss, bxs, bxl)
    wk_struct = s_calc_structure_factor(wk_dir, d1, d2, d3, bstk, brstk, adx_v, "")

    // Trend persistence: count last 8 weekly bars where MB agrees with wk_dir
    bars_aligned = 0
    for k = 0 to 7
        if (wk_dir > 0 and mb[k] > 0) or (wk_dir < 0 and mb[k] < 0)
            bars_aligned += 1
    persistence = bars_aligned >= 6 ? 90.0 : bars_aligned >= 4 ? 75.0 : bars_aligned >= 2 ? 55.0 : 35.0

    wk_score = wk_trend * 0.40 + wk_struct * 0.35 + persistence * 0.25
    [wk_score, wk_dir]

// ── Factor 3: Entry Quality (4H) ───────────────────────────────────────────
// Core innovation: scores HOW GOOD the current 4H bar is as an entry point
// within the Daily-confirmed trend. Four sub-components:
//   1. Pullback depth  (40%) — continuous sigmoid centred at 4H EMA-8
//   2. Momentum reset  (30%) — BXS opposing trend + price curling = ideal trigger
//   3. Vol contraction (15%) — squeeze / RVOL dry-up = coiled spring
//   4. Overextension   (15%) — continuous gradient replaces binary 3×ATR block
// dir = Daily direction (+1 CALL, -1 PUT). All 4H values passed as arguments.
s_calc_entry_quality_4h(dir, c_now, e8_4h, e21_4h, atr_4h, rvol_4h, ch1_4h, bxs_4h, is_sqz_4h) =>
    d1_4h        = e8_4h  > 0 ? (c_now - e8_4h)  / e8_4h  * 100.0 : 0.0
    dist_e21_atr = atr_4h > 0 ? (c_now - e21_4h) / atr_4h * dir   : 0.0
    dir_d1       = dir > 0 ? d1_4h : -d1_4h   // positive = chasing, negative = pullback

    // 1. Pullback depth — piecewise linear approximation of sigmoid
    pb_raw = dir_d1 > 2.0 ? -0.40 : dir_d1 > 1.0 ? -0.40 + (2.0 - dir_d1) * 0.25 : dir_d1 > 0.0 ? -0.15 + (1.0 - dir_d1) * 0.25 : dir_d1 > -0.5 ? 0.10 + math.abs(dir_d1) * 0.60 : dir_d1 > -1.5 ? 0.40 : 0.40 - (math.abs(dir_d1) - 1.5) * 0.20
    e21_bonus = dist_e21_atr < 0.5 ? 0.10 : dist_e21_atr < 1.0 ? 0.05 : 0.0

    // 2. Momentum reset — BXS deeply negative in trend dir + price curling = perfect trigger
    //    (Implements: "RSI resets <40 and curls up while Daily trend is up")
    bxs_dir  = bxs_4h * dir
    ch1_dir  = ch1_4h * dir
    mom_reset = bxs_dir < -5 and ch1_dir > 0 ? 0.35 : bxs_dir < 0 and ch1_dir > 0 ? 0.25 : bxs_dir < 0 and ch1_dir >= -0.1 ? 0.15 : bxs_dir > 0 and ch1_dir > 0.5 ? -0.15 : bxs_dir > 10 ? -0.20 : 0.0

    // 3. Volatility contraction
    vol_contr = is_sqz_4h ? 0.30 : rvol_4h < 0.7 ? 0.15 : rvol_4h < 1.0 ? 0.05 : 0.0

    // 4. Overextension penalty — continuous gradient (no more binary cliff)
    abs_dist = math.abs(dist_e21_atr)
    overext  = abs_dist > 3.0 ? -0.40 : abs_dist > 2.5 ? -0.30 : abs_dist > 2.0 ? -0.15 : abs_dist > 1.5 ? -0.05 : 0.0

    eq_raw = (pb_raw + e21_bonus) * 0.40 + mom_reset * 0.30 + vol_contr * 0.15 + overext * 0.15
    math.max(math.min(50.0 + eq_raw * 100.0, 100.0), 0.0)

// ── Daily HTF Data Pack ────────────────────────────────────────────────────
// Called via: request.security(sym, "D", s_calc_daily_htf(...))
// Computes full indicator suite on the Daily bar, then packages Trend Factor,
// Structure Factor, and supporting values for consumption by the 4H native loop.
// Returns 13-tuple: [sc_trend, sc_struct, dir, sn, st, sc, adx_v, e2, d1, mb, bxs, bxl, is_sqz_hist]
s_calc_daily_htf(c_mb1, c_mb2, c_mb3, c_s1, c_s2, c_s3, c_l1, c_l2, c_e1, c_e2, c_e3) =>
    [mb, isb, iss, bsb, bss]                           = s_calc_mb(close, open, high, low, c_mb1, c_mb2, c_mb3)
    [bxs, mabxs, bxl, rvu, rvd, cru, crd]             = s_calc_bx(close, c_s1, c_s2, c_s3, c_l1, c_l2)
    [e1, e2, e3, d1, d2, d3, bstk, brstk, t2, t3, cup1, cdn1] = s_calc_emas(close, c_e1, c_e2, c_e3)
    [adx_v, pdi, mdi]                                  = s_calc_adx(14)
    [rvol_now, rvol_2bar_d]                            = s_calc_rvol(volume, rvol_period)

    // Daily direction: bull when ISB + BXS positive; bear when not ISB + BXS negative
    dir = isb and bxs > 0 ? 1.0 : (not isb and bxs < 0 ? -1.0 : 0.0)

    // Volatility squeeze on Daily (3-bar lookback)
    bb_dev_d    = 2.0 * ta.stdev(close, 20)
    kc_dev_d    = 1.5 * ta.atr(20)
    is_sqz_d    = (ta.sma(close, 20) + bb_dev_d) < (ta.ema(close, 20) + kc_dev_d) and
                  (ta.sma(close, 20) - bb_dev_d) > (ta.ema(close, 20) - kc_dev_d)
    is_sqz_hist = is_sqz_d or is_sqz_d[1] or is_sqz_d[2]

    // Setup identification (runs on Daily)
    [sn, st, sc] = s_identify(mb, isb, bsb, bss, bxs, bxl, rvu, rvd, cru, crd,
                               d1, d2, d3, bstk, brstk, t2, t3, cup1, cdn1,
                               rvol_now, pb_rvol_max, is_sqz_hist)

    // V4 factors computed on Daily context
    sc_trend  = s_calc_trend_factor(dir, mb, iss, bxs, bxl)
    sc_struct = s_calc_structure_factor(dir, d1, d2, d3, bstk, brstk, adx_v, sn)

    // Pack return: trend factor, structure factor, direction, setup triplet,
    //              ADX, EMA-21 (for 4H overextension calc), EMA gap d1, raw MB, BXS, BXL, squeeze
    [sc_trend, sc_struct, dir, sn, st, sc, adx_v, e2, d1, mb, bxs, bxl, is_sqz_hist]

// ==========================================
// 5. MAIN SCANNER FUNCTION (v3.4)
// ==========================================
s_get_data_v3(w1, w2, w3, w4, w5, w6, w7, c_mb1, c_mb2, c_mb3, c_s1, c_s2, c_s3, c_l1, c_l2, c_e1, c_e2, c_e3) =>

    // RVOL (First so we can use it in identify)
    [rvol_now, rvol_2bar] = s_calc_rvol(volume, rvol_period)

    // Core
    [mb,isb,iss,bsb,bss]                                         = s_calc_mb(close,open,high,low,c_mb1, c_mb2, c_mb3)
    [bxs,mabxs,bxl,rvu,rvd,cru,crd]                             = s_calc_bx(close,c_s1,c_s2,c_s3,c_l1,c_l2)
    [e1,e2,e3,d1,d2,d3,bstk,brstk,t2,t3,cup1,cdn1]        = s_calc_emas(close, c_e1, c_e2, c_e3)

    // Volatility Contraction (Squeeze)
    bb_dev = 2.0 * ta.stdev(close, 20)
    kc_dev = 1.5 * ta.atr(20)
    is_sqz = (ta.sma(close, 20) + bb_dev) < (ta.ema(close, 20) + kc_dev) and (ta.sma(close, 20) - bb_dev) > (ta.ema(close, 20) - kc_dev)
    is_sqz_hist = is_sqz or is_sqz[1] or is_sqz[2]

    [sn,st,sc]                                                    = s_identify(mb,isb,bsb,bss,bxs,bxl,rvu,rvd,cru,crd,d1,d2,d3,bstk,brstk,t2,t3,cup1,cdn1, rvol_now, pb_rvol_max, is_sqz_hist)

    // ADX
    [adx_v, plus_di, minus_di] = s_calc_adx(adx_period)
    is_trending = adx_v > adx_trend_thresh
    is_ranging  = adx_v < adx_range_thresh
    regime_str  = is_trending ? "Trend" : is_ranging ? "Range" : "Neut"



    // Dynamic Weights (ADX shifts emphasis between oscillators and structure)
    float dw1=w1, float dw2=w2, float dw3=w3, float dw4=w4, float dw5=w5, float dw6=w6, float dw7=w7
    if use_adx
        if is_trending
            dw4:=w4*1.5, dw1:=w1*0.9, dw2:=w2*0.9
        else if is_ranging
            dw1:=w1*1.2, dw2:=w2*1.2, dw4:=w4*0.6

    // Direction-aware scoring: each component scored relative to setup direction
    // base 50 ± direction_credit ± strength_bonus → range 15–100
    dir = st == "CALL" ? 1.0 : st == "PUT" ? -1.0 : 0.0

    // ── MB Score ──────────────────────────────────────────
    // mb > 0 = bullish oscillator, mb < 0 = bearish
    // For CALL: want mb > 0 → mb * dir > 0 → aligned
    // For PUT:  want mb < 0 → mb * (-1) > 0 → aligned
    mb_aligned = mb * dir  // positive = aligned, negative = conflicting
    mb_credit  = mb_aligned > 0 ? math.min(math.abs(mb) * 3, 30.0) : -math.min(math.abs(mb) * 2, 35.0)
    mb_str_bonus = mb_aligned > 0 and iss ? 20.0 : 0.0
    sc_mb = math.max(math.min(50.0 + mb_credit + mb_str_bonus, 100.0), 15.0)

    // ── BXS Score ─────────────────────────────────────────
    bxs_aligned = bxs * dir
    bxs_credit  = bxs_aligned > 0 ? math.min(math.abs(bxs) * 1.5, 30.0) : -math.min(math.abs(bxs) * 1.5, 35.0)
    bxs_momentum_bonus = (mabxs > mabxs[1] and bxs_aligned > 0) ? 10.0 : 0.0
    bxs_reversal_bonus = ((rvu and st == "CALL") or (rvd and st == "PUT")) ? 10.0 : 0.0
    sc_bxs = math.max(math.min(50.0 + bxs_credit + bxs_momentum_bonus + bxs_reversal_bonus, 100.0), 15.0)

    // ── BXL Score ─────────────────────────────────────────
    bxl_aligned = bxl * dir
    bxl_credit  = bxl_aligned > 0 ? math.min(math.abs(bxl) * 2, 50.0) : -math.min(math.abs(bxl) * 2, 35.0)
    sc_bxl = math.max(math.min(50.0 + bxl_credit, 100.0), 15.0)

    // ── EMA Score ─────────────────────────────────────────
    // Direction-aware: bullish stack = good for CALL, bad for PUT
    ema_call_aligned = d1 > 0 and d2 > 0 and bstk
    ema_put_aligned  = d1 < 0 and d2 < 0 and brstk
    ema_with_dir = (st == "CALL" and ema_call_aligned) or (st == "PUT" and ema_put_aligned)
    ema_against  = (st == "CALL" and ema_put_aligned)  or (st == "PUT" and ema_call_aligned)
    sc_ema = ema_with_dir ? 90.0 : ema_against ? 25.0 : 55.0
    // Partial credit: aligned direction but not full stack
    ema_partial_call = d1 > 0 and st == "CALL" and not ema_call_aligned
    ema_partial_put  = d1 < 0 and st == "PUT"  and not ema_put_aligned
    sc_ema := (ema_partial_call or ema_partial_put) ? 70.0 : sc_ema

    // ── Momentum Score ────────────────────────────────────
    ch1  = nz(close[1]) > 0 ? (close - close[1])  / close[1]  * 100 : 0.0
    ch3  = nz(close[3]) > 0 ? (close - close[3])  / close[3]  * 100 : 0.0
    ch10 = nz(close[10]) > 0 ? (close - close[10]) / close[10] * 100 : 0.0

    // Normalize momentum using ATR
    atr_pct = (ta.atr(14) / nz(close, 1)) * 100
    norm_ch1  = atr_pct > 0 ? ch1 / atr_pct : 0.0
    norm_ch3  = atr_pct > 0 ? ch3 / (atr_pct * math.sqrt(3)) : 0.0
    norm_ch10 = atr_pct > 0 ? ch10 / (atr_pct * math.sqrt(10)) : 0.0

    // Direction-aware momentum: aligned changes score high, opposing score low
    mom1_aligned = norm_ch1 * dir, mom3_aligned = norm_ch3 * dir, mom10_aligned = norm_ch10 * dir

    // Each tier: aligned strong = 30, aligned weak = 15, flat = 5, opposing = -10
    mom_t1  = mom1_aligned  > 0 ? (math.abs(norm_ch1)  > 1.0 ? 30.0 : math.abs(norm_ch1)  > 0.3 ? 15.0 : 5.0) : (math.abs(norm_ch1)  > 1.0 ? -10.0 : -5.0)
    mom_t3  = mom3_aligned  > 0 ? (math.abs(norm_ch3)  > 1.0 ? 30.0 : math.abs(norm_ch3)  > 0.3 ? 15.0 : 5.0) : (math.abs(norm_ch3)  > 1.0 ? -10.0 : -5.0)
    mom_t10 = mom10_aligned > 0 ? (math.abs(norm_ch10) > 1.0 ? 30.0 : math.abs(norm_ch10) > 0.3 ? 15.0 : 5.0) : (math.abs(norm_ch10) > 1.0 ? -10.0 : -5.0)

    // Weighted blend: ch10 (40%) > ch3 (35%) > ch1 (25%)
    sc_mom = math.max(math.min(50.0 + (mom_t1 * 0.25 + mom_t3 * 0.35 + mom_t10 * 0.40) * 1.6, 100.0), 15.0)

    // ── ADX Regime Score
    is_weak_setup = sn == "Bullish" or sn == "Bearish" or sn == "Mixed"
    is_mid_setup  = sn == "Directional" or sn == "Pullback Buy" or sn == "Failed Rally" or sn == "Divergence" or sn == "Distribution"
    is_strong_setup = sn == "Perfect Storm" or sn == "Breakout" or sn == "Breakdown" or sn == "Strong Trend" or sn == "Strong Down"

    sc_adx = 50.0  // default neutral
    if is_trending
        sc_adx := is_strong_setup ? 95.0 : is_mid_setup ? 80.0 : is_weak_setup ? 55.0 : 50.0
    else if is_ranging
        sc_adx := is_weak_setup ? 65.0 : is_strong_setup ? 35.0 : is_mid_setup ? 45.0 : 50.0
    else  // neutral ADX
        sc_adx := is_mid_setup ? 60.0 : 55.0

    // ── RVOL Score
    sc_vol = rvol_2bar >= 2.0 ? 100.0 : rvol_2bar >= 1.5 ? 90.0 : rvol_2bar >= rvol_threshold ? 75.0 : rvol_2bar >= 1.0 ? 60.0 : rvol_2bar >= 0.7 ? 40.0 : 25.0

    // COMPOSITE SCORE
    f_mb  = nz(sc_mb,  50)
    f_bxs = nz(sc_bxs, 50)
    f_bxl = nz(sc_bxl, 50)
    f_ema = nz(sc_ema, 50)
    f_mom = nz(sc_mom, 50)
    f_adx = nz(sc_adx, 50)
    f_vol = nz(sc_vol, 50)
    tot   = dw1 + dw2 + dw3 + dw4 + dw5 + dw6 + dw7
    comp  = f_mb * (dw1/tot) + f_bxs * (dw2/tot) + f_bxl * (dw3/tot) + f_ema * (dw4/tot) + f_mom * (dw5/tot) + f_adx * (dw6/tot) + f_vol * (dw7/tot)

    // Coherence: 3 core indicators agree with direction
    core_agree = (mb_aligned > 0 ? 1 : 0) + (bxs_aligned > 0 ? 1 : 0) + (bxl_aligned > 0 ? 1 : 0)
    coherence_mult = core_agree == 3 ? 1.10 : core_agree == 2 ? 1.0 : core_agree == 1 ? 0.85 : 0.70
    comp := math.min(comp * coherence_mult, 100.0)

    // NEUTRAL hard cap at 55
    comp := st == "NEUTRAL" ? math.min(comp, 55.0) : comp

    // Non-linear Boost (only if coherence is perfect)
    boost_active = use_boost and f_mb >= boost_mb_thresh and f_bxs >= boost_bxs_thresh and core_agree == 3
    comp        := boost_active ? math.min(comp * 1.1, 100) : comp

    // Squeeze Bonus
    if is_sqz_hist and (sn == "Squeeze Breakout" or sn == "Squeeze Breakdown")
        comp := math.min(comp + 5.0, 100.0)

    overext   = use_mr_filter and math.abs(close - e2) > (mr_stddev_mult * ta.atr(mr_lookback))
    ema50_guard = st == "PUT" and close > e3

    // --- Pullback Quality Gate (mirrors tech-analysis.js logic) ---
    // For CALL: best entry when price is AT or BELOW EMA-8 (d1 <= 0)
    //           worst entry when price is >1.5% ABOVE EMA-8 (chasing the breakout)
    // For PUT:  mirror image — best when d1 >= 0 (price at/above EMA-8), worst when d1 < -1.5%
    dir_d1 = st == "CALL" ? d1 : st == "PUT" ? -d1 : 0.0
    pb_qual = dir_d1 > 1.5 ? "EXTENDED" : dir_d1 > 0.0 ? "MOMENTUM" : dir_d1 >= -0.5 ? "SWEET" : "PULLBACK"

    sig = "❌ AVOID"
    if overext
        sig := "⚠️ OVEREXT"
    else if st == "CALL"
        // Pullback quality gate: don't chase >1.5% above EMA-8
        if pb_qual == "EXTENDED"
            sig := comp >= 80 ? "⏳ WAIT PB" : "👀 WATCH · CALL"
        else if comp >= 80 and sc == 3 and pb_qual == "PULLBACK"
            sig := "🟢 STR BUY" + (boost_active ? " 🔥" : "")   // ideal entry: EMA-8 retest
        else if comp >= 80 and sc == 3
            sig := "🟢 BUY" + (boost_active ? " 🔥" : "")       // on the break: acceptable
        else if comp >= 80
            sig := "🟢 BUY"
        else if comp >= 70
            sig := "🟡 BUY"
        else
            sig := "👀 WATCH · CALL"
    else if st == "PUT"
        is_high_conf_down = comp >= 80 and sc == 3 and rvol_2bar >= 1.0
        is_valid_put      = comp >= 70 and rvol_2bar >= 0.8
        if ema50_guard
            sig := "👀 WATCH · PUT"
        else if pb_qual == "EXTENDED"
            sig := comp >= 80 ? "⏳ WAIT PB" : "👀 WATCH · PUT"
        else if is_high_conf_down and pb_qual == "PULLBACK"
            sig := "🔴 STR SELL" + (boost_active ? " 🔥" : "")  // ideal entry: EMA-8 retest
        else if is_high_conf_down
            sig := "🔴 SELL" + (boost_active ? " 🔥" : "")      // on the break: acceptable
        else if comp >= 80
            sig := "🔴 SELL"
        else if is_valid_put
            sig := "🟡 SELL"
        else
            sig := "👀 WATCH · PUT"

    // Market State for UI
    mkt_state = "TRENDING"
    if is_trending and boost_active
        mkt_state := "EXPLOSIVE"
    else if rvu or rvd
        mkt_state := "REVERTING"
    else if is_ranging
        mkt_state := "RANGING"
    else if is_trending
        mkt_state := "TRENDING"

    // Return d1_display: direction-aware ema distance for the table column
    // For CALL: positive = above EMA-8 (chase), negative = below (pullback) — raw d1 is fine
    // For PUT:  we FLIP the sign so the table reads intuitively:
    //   PUT with d1=-2% → display as +2% EXT! (chasing breakdown)
    //   PUT with d1=+1% → display as -1% PB✓  (price above EMA-8 = ideal short entry)
    d1_display = st == "PUT" ? -d1 : d1

    [comp, sig, sn, st, sc, mb, bxs, bxl, d1_display, d2, rvu or rvd, rvol_2bar, regime_str, overext, adx_v, mkt_state, pb_qual]

// ==========================================
// 5B. V4 MAIN SCANNER FUNCTION (4H native)
// ==========================================
// Accepts pre-computed Daily and Weekly HTF data as scalar arguments.
// 4H native indicators are computed on whatever symbol/TF request.security() runs this function with.
// Call pattern:
//   [d_trend,...,d_sqz]   = request.security(sym, "D",   s_calc_daily_htf(...))
//   [wk_score, wk_dir]    = request.security(sym, "W",   s_calc_weekly_htf(...))
//   [s_comp, s_sig, ...]  = request.security(sym, "240", s_get_data_v4(d_trend,...,wk_score,wk_dir,...))
// Returns same 17-value tuple as s_get_data_v3 for display compatibility.
// s_get_data_v4 params: d_trend..d_sqz (13 from s_calc_daily_htf), wk_score/wk_dir (from s_calc_weekly_htf), c_mb1..c_l2 (4H config)
s_get_data_v4(d_trend, d_struct, d_dir, d_sn, d_st, d_sc, d_adx, d_e21, d_d1, d_mb, d_bxs, d_bxl, d_sqz, wk_score, wk_dir, c_mb1, c_mb2, c_mb3, c_s1, c_s2, c_s3, c_l1, c_l2) =>

    // ── 4H Native Indicators ──────────────────────────────────────────────────
    e8_4h  = ta.ema(close, 8)
    e21_4h = ta.ema(close, 21)
    atr_4h = ta.atr(14)

    [bxs_4h, _, _, rvu_4h, rvd_4h, _, _] = s_calc_bx(close, c_s1, c_s2, c_s3, c_l1, c_l2)
    [rvol_4h, rvol_2bar_4h]               = s_calc_rvol(volume, rvol_period)
    ch1_4h = nz(close[1]) > 0 ? (close - close[1]) / close[1] * 100.0 : 0.0

    bb_dev_4h   = 2.0 * ta.stdev(close, 20)
    kc_dev_4h   = 1.5 * ta.atr(20)
    sqz_4h      = (ta.sma(close, 20) + bb_dev_4h) < (ta.ema(close, 20) + kc_dev_4h) and
                  (ta.sma(close, 20) - bb_dev_4h) > (ta.ema(close, 20) - kc_dev_4h)
    sqz_4h_hist = sqz_4h or sqz_4h[1] or sqz_4h[2]

    // Daily direction drives all computation
    dir = nz(d_dir, 0.0)

    // ── Factor 3: Entry Quality (4H) ─────────────────────────────────────────
    // Pass d_e21 (Daily EMA-21 price) as the reference for overextension check.
    // This ensures the overextension penalty is relative to the Daily trend level,
    // not the local 4H EMA (which could be near price even when Daily-overextended).
    d_e21_safe = nz(d_e21, e21_4h)  // fallback to 4H EMA-21 if Daily unavailable
    sc_entry   = s_calc_entry_quality_4h(dir, close, e8_4h, d_e21_safe, atr_4h,
                                          rvol_4h, ch1_4h, bxs_4h, sqz_4h_hist)

    // ── Factor 4: Volume Confirmation (4H) ───────────────────────────────────
    sc_vol = rvol_2bar_4h >= 2.0 ? 100.0 : rvol_2bar_4h >= 1.5 ? 90.0 :
             rvol_2bar_4h >= rvol_threshold ? 75.0 : rvol_2bar_4h >= 1.0 ? 60.0 :
             rvol_2bar_4h >= 0.7 ? 40.0 : 25.0

    // ── Hierarchical Composite ────────────────────────────────────────────────
    base       = nz(d_trend, 50.0) * 0.50 + nz(d_struct, 50.0) * 0.30 + sc_vol * 0.20
    eq_norm    = (sc_entry - 50.0) / 50.0                        // -1 (chasing) to +1 (pullback)
    entry_mult = 1.0 + eq_norm * 0.30                            // 0.70 to 1.30
    if base > 75.0 and entry_mult < 0.85
        entry_mult := 0.85  // floor: don't fully block strong breakouts

    core_agree = (nz(d_mb) * dir > 0 ? 1 : 0) + (nz(d_bxs) * dir > 0 ? 1 : 0) + (nz(d_bxl) * dir > 0 ? 1 : 0)
    coherence  = core_agree == 3 ? 1.10 : core_agree == 2 ? 1.0 : core_agree == 1 ? 0.85 : 0.70

    wk_dir_f   = nz(wk_dir, 0.0)
    wk_scr_f   = nz(wk_score, 50.0)
    mtf_aligned = (dir > 0 and wk_dir_f > 0) or (dir < 0 and wk_dir_f < 0)
    mtf_opposed = (dir > 0 and wk_dir_f < 0) or (dir < 0 and wk_dir_f > 0)
    mtf_mod = mtf_aligned ? 1.0 + (wk_scr_f - 50.0) / 500.0 : mtf_opposed and wk_scr_f > 65 ? 0.75 : mtf_opposed and wk_scr_f > 55 ? 0.85 : mtf_opposed ? 0.92 : 1.0

    comp = math.min(base * entry_mult * coherence * mtf_mod, 100.0)

    // NEUTRAL hard cap at 55 (keep same as v3)
    st = dir > 0 ? "CALL" : dir < 0 ? "PUT" : "NEUTRAL"
    comp := st == "NEUTRAL" ? math.min(comp, 55.0) : comp

    // ── Entry Context & Confidence Adjustment ─────────────────────────────────
    entry_ctx = sc_entry >= 75 ? "OPTIMAL" : sc_entry >= 60 ? "ACCEPTABLE" : sc_entry >= 45 ? "MARGINAL" : "CHASING"

    conf = nz(d_sc, 1)
    if conf == 3 and entry_ctx == "CHASING"
        conf := 2  // downgrade: strong trend but chasing breakout
    if conf == 2 and entry_ctx == "OPTIMAL"
        conf := 3  // upgrade: pullback entry within confirmed trend

    // ── Signal Generation (entry-context-aware, Step 7) ──────────────────────
    atr_4h_safe = math.max(atr_4h, 0.0001)
    // Overextension vs Daily EMA-21 (absolute, not direction-aware for the flag)
    overext_dist = math.abs(close - d_e21_safe) / atr_4h_safe
    overext_flag = use_mr_filter and overext_dist > mr_stddev_mult

    sig = "👀 WATCH"
    if overext_flag
        sig := "⚠️ OVEREXT"
    else if st == "CALL"
        if entry_ctx == "CHASING" and comp >= 80
            sig := "⏳ WAIT PB"
        else if entry_ctx == "CHASING"
            sig := "👀 WATCH · CALL"
        else if comp >= 85 and conf == 3 and entry_ctx == "OPTIMAL"
            sig := "🟢 STR BUY ✦"   // pullback to 4H EMA in Daily strong trend
        else if comp >= 75 and entry_ctx == "OPTIMAL"
            sig := "🟢 BUY ✦"       // OPTIMAL entry at any conf
        else if comp >= 80 and entry_ctx == "ACCEPTABLE"
            sig := "🟢 BUY"
        else if comp >= 70
            sig := "🟡 BUY"
        else if entry_ctx == "OPTIMAL" and comp >= 60
            sig := "👀 WATCH PB✓"   // ideal entry but weak Daily trend
        else
            sig := "👀 WATCH · CALL"
    else if st == "PUT"
        if entry_ctx == "CHASING" and comp >= 80
            sig := "⏳ WAIT PB"
        else if entry_ctx == "CHASING"
            sig := "👀 WATCH · PUT"
        else if comp >= 85 and conf == 3 and entry_ctx == "OPTIMAL"
            sig := "🔴 STR SELL ✦"
        else if comp >= 75 and entry_ctx == "OPTIMAL"
            sig := "🔴 SELL ✦"
        else if comp >= 80 and entry_ctx == "ACCEPTABLE"
            sig := "🔴 SELL"
        else if comp >= 70
            sig := "🟡 SELL"
        else if entry_ctx == "OPTIMAL" and comp >= 60
            sig := "👀 WATCH PB✓"
        else
            sig := "👀 WATCH · PUT"

    // ── Return Values (17-tuple, display compatible with s_get_data_v3) ───────
    d1_4h         = e8_4h > 0 ? (close - e8_4h) / e8_4h * 100.0 : 0.0
    d1_display_4h = st == "PUT" ? -d1_4h : d1_4h
    // d2 = Daily EMA-21 distance % (for context column)
    d2_daily      = d_e21_safe > 0 ? (close - d_e21_safe) / d_e21_safe * 100.0 : 0.0
    regime_v4     = entry_ctx + " W" + (wk_dir_f > 0 ? "↑" : wk_dir_f < 0 ? "↓" : "~")
    mkt_state_v4  = entry_ctx
    sn_out        = na(d_sn) ? "v4" : d_sn

    [comp, sig, sn_out, st, conf, nz(d_mb), bxs_4h, nz(d_bxl), d1_display_4h, d2_daily,
     rvu_4h or rvd_4h, rvol_2bar_4h, regime_v4, overext_flag, nz(d_adx), mkt_state_v4, entry_ctx]

// V4 scanner function — Daily-only composite (Pine Script v6 loop-safe).
// Runs entirely at Daily timeframe to avoid passing loop-local mutable variables
// to request.security() expression arguments (v6 restriction).
// Weekly direction approximated via 10d/20d/50d EMA hierarchy on daily bars.
// Returns same 17-tuple as s_get_data_v4 for display compatibility.
s_scanner_v4_daily_only(c_mb1, c_mb2, c_mb3, c_s1, c_s2, c_s3, c_l1, c_l2, c_e1, c_e2, c_e3) =>
    // ── Core Daily Indicators ──────────────────────────────────────────────────
    [mb, isb, iss, bsb, bss]                                   = s_calc_mb(close, open, high, low, c_mb1, c_mb2, c_mb3)
    [bxs, mabxs, bxl, rvu, rvd, cru, crd]                     = s_calc_bx(close, c_s1, c_s2, c_s3, c_l1, c_l2)
    [e1, e2, e3, d1, d2, d3, bstk, brstk, t2, t3, cup1, cdn1] = s_calc_emas(close, c_e1, c_e2, c_e3)
    [adx_v, pdi, mdi]                                          = s_calc_adx(14)
    [rvol_now, rvol_2bar_d]                                    = s_calc_rvol(volume, rvol_period)
    bb_dev_d    = 2.0 * ta.stdev(close, 20)
    kc_dev_d    = 1.5 * ta.atr(20)
    is_sqz_d    = (ta.sma(close, 20) + bb_dev_d) < (ta.ema(close, 20) + kc_dev_d) and
                  (ta.sma(close, 20) - bb_dev_d) > (ta.ema(close, 20) - kc_dev_d)
    is_sqz_hist = is_sqz_d or is_sqz_d[1] or is_sqz_d[2]
    [sn, st, sc] = s_identify(mb, isb, bsb, bss, bxs, bxl, rvu, rvd, cru, crd,
                               d1, d2, d3, bstk, brstk, t2, t3, cup1, cdn1,
                               rvol_now, pb_rvol_max, is_sqz_hist)
    // Daily direction (same logic as s_calc_daily_htf)
    dir   = isb and bxs > 0 ? 1.0 : (not isb and bxs < 0 ? -1.0 : 0.0)
    st_v4 = dir > 0 ? "CALL" : dir < 0 ? "PUT" : "NEUTRAL"
    // ── V4 Factors on Daily ────────────────────────────────────────────────────
    sc_trend  = s_calc_trend_factor(dir, mb, iss, bxs, bxl)
    sc_struct = s_calc_structure_factor(dir, d1, d2, d3, bstk, brstk, adx_v, sn)
    // ── Volume (daily) ──────────────────────────────────────────────────────────
    sc_vol = rvol_2bar_d >= 2.0 ? 100.0 : rvol_2bar_d >= 1.5 ? 90.0 :
             rvol_2bar_d >= rvol_threshold ? 75.0 : rvol_2bar_d >= 1.0 ? 60.0 :
             rvol_2bar_d >= 0.7 ? 40.0 : 25.0
    // ── Weekly direction proxy from daily EMAs ─────────────────────────────────
    // 10d/20d/50d EMAs ≈ 2-week/4-week/10-week direction proxy
    wk_e1 = ta.ema(close, 10)
    wk_e2 = ta.ema(close, 20)
    wk_e3 = ta.ema(close, 50)
    wk_dir_approx   = wk_e1 > wk_e2 and wk_e2 > wk_e3 ? 1.0 :
                      wk_e1 < wk_e2 and wk_e2 < wk_e3 ? -1.0 : 0.0
    wk_score_approx = wk_dir_approx > 0 ? 65.0 : wk_dir_approx < 0 ? 35.0 : 50.0
    // ── Composite (same hierarchy as s_get_data_v4) ────────────────────────────
    base        = nz(sc_trend, 50.0) * 0.50 + nz(sc_struct, 50.0) * 0.30 + sc_vol * 0.20
    // Entry quality: map daily pullback position (d1 = % from EMA-8) to V4 entry context
    dir_d1      = dir > 0 ? d1 : dir < 0 ? -d1 : 0.0
    pb_qual_str = dir_d1 > 1.5 ? "EXTENDED" : dir_d1 > 0.0 ? "MOMENTUM" :
                  dir_d1 >= -0.5 ? "SWEET" : "PULLBACK"
    entry_ctx   = pb_qual_str == "PULLBACK"  ? "OPTIMAL"    :
                  pb_qual_str == "SWEET"     ? "ACCEPTABLE" :
                  pb_qual_str == "MOMENTUM"  ? "MARGINAL"   : "CHASING"
    eq_score    = entry_ctx == "OPTIMAL"     ? 80.0 : entry_ctx == "ACCEPTABLE" ? 65.0 :
                  entry_ctx == "MARGINAL"    ? 50.0 : 35.0
    eq_norm     = (eq_score - 50.0) / 50.0
    entry_mult  = 1.0 + eq_norm * 0.30
    if base > 75.0 and entry_mult < 0.85
        entry_mult := 0.85
    core_agree = (mb * dir > 0 ? 1 : 0) + (bxs * dir > 0 ? 1 : 0) + (bxl * dir > 0 ? 1 : 0)
    coherence  = core_agree == 3 ? 1.10 : core_agree == 2 ? 1.0 : core_agree == 1 ? 0.85 : 0.70
    mtf_aligned = (dir > 0 and wk_dir_approx > 0) or (dir < 0 and wk_dir_approx < 0)
    mtf_opposed = (dir > 0 and wk_dir_approx < 0) or (dir < 0 and wk_dir_approx > 0)
    mtf_mod     = mtf_aligned ? 1.0 + (wk_score_approx - 50.0) / 500.0 :
                  mtf_opposed and wk_score_approx > 65 ? 0.75 :
                  mtf_opposed and wk_score_approx > 55 ? 0.85 :
                  mtf_opposed ? 0.92 : 1.0
    comp = math.min(base * entry_mult * coherence * mtf_mod, 100.0)
    comp := st_v4 == "NEUTRAL" ? math.min(comp, 55.0) : comp
    // Confidence (from daily setup sc)
    conf = nz(sc, 1)
    if conf == 3 and entry_ctx == "CHASING"
        conf := 2
    if conf == 2 and entry_ctx == "OPTIMAL"
        conf := 3
    // ── Overextension vs Daily EMA-21 ──────────────────────────────────────────
    atr_safe     = math.max(ta.atr(14), 0.0001)
    overext_dist = math.abs(close - e2) / atr_safe
    overext_flag = use_mr_filter and overext_dist > mr_stddev_mult
    // ── Signal Generation ──────────────────────────────────────────────────────
    sig = "👀 WATCH"
    if overext_flag
        sig := "⚠️ OVEREXT"
    else if st_v4 == "CALL"
        if entry_ctx == "CHASING" and comp >= 80
            sig := "⏳ WAIT PB"
        else if entry_ctx == "CHASING"
            sig := "👀 WATCH · CALL"
        else if comp >= 85 and conf == 3 and entry_ctx == "OPTIMAL"
            sig := "🟢 STR BUY ✦"
        else if comp >= 75 and entry_ctx == "OPTIMAL"
            sig := "🟢 BUY ✦"
        else if comp >= 80 and entry_ctx == "ACCEPTABLE"
            sig := "🟢 BUY"
        else if comp >= 70
            sig := "🟡 BUY"
        else if entry_ctx == "OPTIMAL" and comp >= 60
            sig := "👀 WATCH PB✓"
        else
            sig := "👀 WATCH · CALL"
    else if st_v4 == "PUT"
        if entry_ctx == "CHASING" and comp >= 80
            sig := "⏳ WAIT PB"
        else if entry_ctx == "CHASING"
            sig := "👀 WATCH · PUT"
        else if comp >= 85 and conf == 3 and entry_ctx == "OPTIMAL"
            sig := "🔴 STR SELL ✦"
        else if comp >= 75 and entry_ctx == "OPTIMAL"
            sig := "🔴 SELL ✦"
        else if comp >= 80 and entry_ctx == "ACCEPTABLE"
            sig := "🔴 SELL"
        else if comp >= 70
            sig := "🟡 SELL"
        else if entry_ctx == "OPTIMAL" and comp >= 60
            sig := "👀 WATCH PB✓"
        else
            sig := "👀 WATCH · PUT"
    // ── Return (17-tuple, display-compatible with s_get_data_v3/v4) ────────────
    d1_display = st_v4 == "PUT" ? -d1 : d1
    d2_daily   = e2 > 0 ? (close - e2) / e2 * 100.0 : 0.0
    regime_out = entry_ctx + " W" + (wk_dir_approx > 0 ? "↑" : wk_dir_approx < 0 ? "↓" : "~")
    sn_out     = na(sn) ? "v4" : sn
    [comp, sig, sn_out, st_v4, conf, nz(mb), bxs, nz(bxl), d1_display, d2_daily,
     rvu or rvd, rvol_2bar_d, regime_out, overext_flag, nz(adx_v), entry_ctx, pb_qual_str]

// ==========================================
// 6. OPTIONS STRUCTURE DECISION MATRIX
// ==========================================
// Extracted so it can be used by both the scanner UI and Backtester
f_get_blocker(s_regime, s_rvol, r_thresh, s_overext, s_mtf_final) =>
    block_msg = ""
    regime_s = str.tostring(s_regime)
    has_vol  = nz(s_rvol, 1.0) >= r_thresh
    // V4 regime format is "OPTIMAL W↑" / "CHASING W↓" etc. (always contains " W")
    // V3 regime format is "Trend" / "Range" / "Neut"
    // V4 already requires daily directional confirmation, so treat it as trending
    is_trending = regime_s == "Trend" or str.contains(regime_s, " W")

    if s_overext
        block_msg += "⚠️ OverExt "
    if s_mtf_final
        block_msg += "⬆️ MTF Conflict "
    if is_trending and not has_vol
        block_msg += "⏳ Low RVOL "
    if not is_trending
        block_msg += "⏳ ADX<25 "
    
    block_msg == "" ? "" : str.trim(block_msg)


// ==========================================
// 6. SCANNER EXECUTION
// ==========================================
var string[]    symbols = str.split(watchlist_input, ",")
var StockData[] results = array.new<StockData>()

if barstate.islast and show_scanner
    array.clear(results)
    // Budget: 40 unique request.* calls max
    // Backtest (if enabled): 3 calls (V3 weekly + V4 daily + V4 weekly for current chart sym)
    // V4 scanner: 1 call/sym via s_scanner_v4_daily_only at "D"
    // V3 scanner: 2 calls/sym (W score + current TF data)
    sym_limit = use_v4_scoring ? (show_backtest ? 35 : 39) : (show_backtest ? 17 : 19)
    for i = 0 to math.min(array.size(symbols) - 1, sym_limit)
        sym = str.trim(array.get(symbols, i))
        if str.length(sym) < 1
            continue

        // Pre-declare all scanner output vars with correct types.
        // Pine Script v6: '=' inside if/else creates LOCAL vars only (not accessible outside).
        // Pattern: tuple-destructure into temp _* names inside branch, then ':=' assign to these
        // outer vars so they are readable after the if/else block.
        float  s_comp      = na
        string s_sig       = na
        string s_setup     = na
        string s_stype     = na
        int    s_conf      = na
        float  s_mb        = na
        float  s_bxs       = na
        float  s_bxl       = na
        float  s_d1        = na
        float  s_d2        = na
        bool   s_rev       = false
        float  s_rvol      = na
        string s_regime    = na
        bool   s_overext   = false
        float  s_adx       = na
        string s_mkt_state = na
        string s_pb_qual   = na
        bool   s_mtf       = false

        if use_v4_scoring
            // ── V4 Path: Daily-only composite (Pine Script v6 loop-safe) ──────
            // s_scanner_v4_daily_only accepts only config params (not loop-local vars),
            // satisfying v6's restriction on request.*() expression arguments.
            [_comp, _sig, _setup, _stype, _conf, _mb, _bxs, _bxl, _d1, _d2,
             _rev, _rvol, _regime, _overext, _adx, _mkt_state, _pb_qual] =
             request.security(sym, "D",
                    s_scanner_v4_daily_only(sc_mb_len, sc_mb_len2, sc_mb_len3,
                        sc_bx_s1, sc_bx_s2, sc_bx_s3, sc_bx_l1, sc_bx_l2,
                        ema_len1, ema_len2, ema_len3),
                    ignore_invalid_symbol=true)
            s_comp      := _comp
            s_sig       := _sig
            s_setup     := _setup
            s_stype     := _stype
            s_conf      := _conf
            s_mb        := _mb
            s_bxs       := _bxs
            s_bxl       := _bxl
            s_d1        := _d1
            s_d2        := _d2
            s_rev       := _rev
            s_rvol      := _rvol
            s_regime    := _regime
            s_overext   := _overext
            s_adx       := _adx
            s_mkt_state := _mkt_state
            s_pb_qual   := _pb_qual
            s_mtf := false

        else
            // ── V3 Path: Legacy daily-only scoring ──────────────────────────
            sym_wk_score = request.security(sym, "W", s_calc_weekly_score(sc_mb_len, sc_mb_len2, sc_mb_len3), ignore_invalid_symbol=true)
            // Temp names, then ':=' to outer vars
            [_comp, _sig, _setup, _stype, _conf, _mb, _bxs, _bxl, _d1, _d2, _rev, _rvol, _regime, _overext, _adx, _mkt_state, _pb_qual] =
             request.security(sym, timeframe.period,
                    s_get_data_v3(w_mb, w_bxs, w_bxl, w_ema, w_mom, w_adx, w_vol,
                        sc_mb_len, sc_mb_len2, sc_mb_len3,
                        sc_bx_s1, sc_bx_s2, sc_bx_s3, sc_bx_l1, sc_bx_l2,
                        ema_len1, ema_len2, ema_len3),
                    ignore_invalid_symbol=true)
            s_comp      := _comp
            s_sig       := _sig
            s_setup     := _setup
            s_stype     := _stype
            s_conf      := _conf
            s_mb        := _mb
            s_bxs       := _bxs
            s_bxl       := _bxl
            s_d1        := _d1
            s_d2        := _d2
            s_rev       := _rev
            s_rvol      := _rvol
            s_regime    := _regime
            s_overext   := _overext
            s_adx       := _adx
            s_mkt_state := _mkt_state
            s_pb_qual   := _pb_qual
            // Apply v3 hard Weekly MTF block
            s_mtf := use_mtf_filter and ((s_stype == "CALL" and sym_wk_score < mtf_score_floor) or (s_stype == "PUT" and sym_wk_score > 52))
            if s_mtf
                if s_stype == "PUT"
                    s_sig := sym_wk_score > 62 ? "⬆️ PULLBACK" : sym_wk_score > 55 ? "⚡ REBOUND RISK" : "🟡 BRKDWN WATCH"
                else if s_stype == "CALL"
                    s_sig := sym_wk_score < 38 ? "🐻 BEAR TREND" : sym_wk_score < 45 ? "⚡ RALLY RISK" : "👀 NEUT WATCH"
                else
                    s_sig := "⬆️ MTF BLOCK"

        incl = (s_stype == "CALL" and show_calls) or (s_stype == "PUT" and show_puts)
        if not na(s_comp) and ((s_comp >= min_score and incl) or min_score == 0)
            blocker_msg = f_get_blocker(s_regime, s_rvol, rvol_threshold, s_overext, s_mtf)
            note = blocker_msg
            display_regime = use_v4_scoring ? str.tostring(s_regime) : str.tostring(s_regime) + " W~"

            array.push(results, StockData.new(sym, s_comp, s_sig, s_setup, s_stype, s_conf,
                 nz(s_mb), nz(s_bxs), nz(s_bxl), nz(s_d1), s_rev ? true : false,
                 nz(s_rvol, 1.0), display_regime,
                 s_overext ? true : false, s_mtf ? true : false,
                 str.tostring(s_mkt_state), note, na(s_pb_qual) ? "MOMENTUM" : s_pb_qual))

// ==========================================
// 7. SCANNER DISPLAY (12 columns)
// ==========================================
// Cols: Symbol | MB | Bx-S | Bx-L | EMA | RVOL | Score Tier | Setup | Direction | Mkt State | Risk Flags | Blocker

if barstate.islast and show_scanner and array.size(results) > 1
    for i = 0 to array.size(results) - 2
        for j = i + 1 to array.size(results) - 1
            if array.get(results, j).score > array.get(results, i).score
                temp = array.get(results, i)
                array.set(results, i, array.get(results, j))
                array.set(results, j, temp)

if barstate.islast and show_scanner and array.size(results) > 0
    tbl_pos = table_position == "top_left" ? position.top_left : table_position == "top_center" ? position.top_center : table_position == "top_right" ? position.top_right : table_position == "middle_left" ? position.middle_left : table_position == "middle_center" ? position.middle_center : table_position == "middle_right" ? position.middle_right : table_position == "bottom_left" ? position.bottom_left : table_position == "bottom_center" ? position.bottom_center : position.bottom_right
    sz = table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "large" ? size.large : size.normal

    var table tbl = table.new(tbl_pos, 12, max_display + 2, border_width=2)
    hdr_bg = color.new(color.blue, 70)
    hdr_tc = color.white

    table.cell(tbl, 0,  0, "Symbol",            bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)
    table.cell(tbl, 1,  0, "MB",                bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)
    table.cell(tbl, 2,  0, "Bx-S",              bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)
    table.cell(tbl, 3,  0, "Bx-L",              bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)
    table.cell(tbl, 4,  0, "EMA",               bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)
    table.cell(tbl, 5,  0, "RVOL",              bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)
    table.cell(tbl, 6,  0, "Score Tier",        bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)
    table.cell(tbl, 7,  0, "Setup",             bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)
    table.cell(tbl, 8,  0, "Direction",         bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)
    table.cell(tbl, 9,  0, "Market State",      bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)
    table.cell(tbl, 10, 0, "Risk Flags",        bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)
    table.cell(tbl, 11, 0, "Blocker",           bgcolor=hdr_bg, text_color=hdr_tc, text_size=sz)

    cnt = math.min(array.size(results), max_display)
    call_cnt = 0, put_cnt = 0

    for i = 0 to cnt - 1
        d = array.get(results, i)
        r = i + 1
        if d.stype == "CALL"
            call_cnt += 1
        if d.stype == "PUT"
            put_cnt  += 1

        // Row-level: determine if this row has an ACTUAL strategy recommendation
        raw_struct = d.note_detail
        is_actionable = raw_struct == "" and d.stype != "NEUTRAL"
        is_call_action = is_actionable and d.stype == "CALL"
        is_put_action  = is_actionable and d.stype == "PUT"

        // Universal row background: dark & neutral for ALL rows
        row_bg   = color.new(color.black, 85)
        muted_tc = color.new(color.white, 40)  // dimmed text
        dim_bg   = color.new(color.black, 92)  // slightly dimmer for non-key cols

        stars = is_actionable ? (d.confidence == 3 ? "⭐⭐⭐" : d.confidence == 2 ? "⭐⭐" : d.confidence == 1 ? "⭐" : "") : ""

        // Col 0: Symbol — keep green/red text for direction, no fancy bg
        sym_color = d.stype == "CALL" ? color.new(color.green, 20) : d.stype == "PUT" ? color.new(color.red, 20) : color.gray
        table.cell(tbl, 0, r, d.symbol, bgcolor=row_bg, text_size=sz, text_color=sym_color)

        // Col 1-4: Indicators — muted green/red text, dark bg
        table.cell(tbl, 1, r, str.tostring(math.round(d.mb_osc, 1)),   bgcolor=dim_bg, text_size=sz, text_color=d.mb_osc   > 0 ? color.new(color.green, 30) : color.new(color.red, 30))
        table.cell(tbl, 2, r, str.tostring(math.round(d.bx_short, 1)), bgcolor=dim_bg, text_size=sz, text_color=d.bx_short > 0 ? color.new(color.green, 30) : color.new(color.red, 30))
        table.cell(tbl, 3, r, str.tostring(math.round(d.bx_long, 1)),  bgcolor=dim_bg, text_size=sz, text_color=d.bx_long  > 0 ? color.new(color.green, 30) : color.new(color.red, 30))
        // Col 4: EMA d8% + Pullback Quality label
        pb_label = d.pb_qual == "PULLBACK" ? " PB✓" : d.pb_qual == "SWEET" ? " OK" : d.pb_qual == "EXTENDED" ? " EXT!" : ""
        pb_ema_tc = d.pb_qual == "PULLBACK" ? color.lime : d.pb_qual == "SWEET" ? color.new(color.green, 30) : d.pb_qual == "EXTENDED" ? color.new(color.orange, 10) : (d.dist_ema1 > 0 ? color.new(color.green, 30) : color.new(color.red, 30))
        table.cell(tbl, 4, r, str.tostring(math.round(d.dist_ema1, 1)) + "%" + pb_label, bgcolor=dim_bg, text_size=sz, text_color=pb_ema_tc)

        // Col 5: RVOL — only color RVOL itself, keep bg dark
        rvol_txt = str.tostring(math.round(d.rvol, 2)) + "x"
        rvol_tc  = d.rvol >= rvol_threshold * 1.5 ? color.lime : d.rvol >= rvol_threshold ? color.teal : d.rvol >= 0.8 ? color.silver : color.new(color.red, 20)
        table.cell(tbl, 5, r, rvol_txt, bgcolor=dim_bg, text_size=sz, text_color=rvol_tc)

        // Col 6: Score Tier
        score_tier = d.score >= 90 ? "S (90+)" : d.score >= 80 ? "A (80–89)" : d.score >= 70 ? "B (70–79)" : d.score >= 60 ? "C (60–69)" : "D (<60)"
        tier_tc = d.score >= 90 ? color.lime : d.score >= 80 ? color.green : d.score >= 70 ? color.yellow : d.score >= 60 ? color.orange : color.red
        table.cell(tbl, 6, r, score_tier, bgcolor=row_bg, text_size=sz, text_color=tier_tc)

        // Col 7: Setup
        setup_txt = d.setup == "Mixed" ? "Mixed" : d.setup + (d.reversal ? " 🔄" : "") + (stars != "" ? " " + stars : "")
        table.cell(tbl, 7, r, setup_txt, bgcolor=row_bg, text_size=sz, text_color=muted_tc)

        // Col 8: Direction
        dir_txt    = d.stype == "CALL" ? "BULL" : d.stype == "PUT" ? "BEAR" : ""
        dir_tc     = d.stype == "CALL" ? color.lime : d.stype == "PUT" ? color.red : color.gray
        table.cell(tbl, 8, r, dir_txt, bgcolor=row_bg, text_size=sz, text_color=dir_tc)

        // Col 9: Market State
        mkt_tc = d.market_state == "EXPLOSIVE" ? color.new(color.yellow, 20) : color.white
        table.cell(tbl, 9, r, d.market_state, bgcolor=row_bg, text_size=sz, text_color=mkt_tc)

        // Col 10: Risk Flags (including pullback quality)
        string risk_str = ""
        if d.overextended or str.contains(raw_struct, "OverExt")
            risk_str := risk_str + "⚠️Ext "
        if d.pb_qual == "EXTENDED"
            risk_str := risk_str + "⏳PB "
        if d.mtf_conflict or str.contains(raw_struct, "MTF")
            risk_str := risk_str + "⬆️MTF "
        if str.contains(raw_struct, "LowVol") or str.contains(raw_struct, "Low RVOL")
            risk_str := risk_str + "⏳Vol "
        
        table.cell(tbl, 10, r, risk_str, bgcolor=row_bg, text_size=sz, text_color=color.new(color.orange, 20))

        // Col 11: Blocker
        string blocker_str = raw_struct
        if blocker_str == ""
            blocker_str := "✅ Clear"

        table.cell(tbl, 11, r, blocker_str, bgcolor=row_bg, text_size=sz, text_color=is_actionable ? color.new(color.green, 50) : color.new(color.red, 30))


    // Summary row
    sum_row = cnt + 1
    sum_txt = str.tostring(cnt) + " setups | " + str.tostring(call_cnt) + " CALLS · " + str.tostring(put_cnt) + " PUTS  |  v3.4 — Real Weekly MTF + MaxFav/Adv"
    table.merge_cells(tbl, 0, sum_row, 11, sum_row)
    table.cell(tbl, 0, sum_row, sum_txt, bgcolor=color.new(color.blue, 90), text_size=size.small, text_color=color.white)

// ==========================================
// 8. FORWARD EXPECTANCY ANALYSIS (BACKTEST)
// ==========================================
// This section tracks signals on the CURRENT chart symbol and calculates 
// how price moved 14 and 30 bars after the signal.

f_draw_bt_row(tbl_id, row, label, t_count, c7, s7, m7, a7, c14, s14, m14, a14, c30, s30, m30, a30) =>
    r7_mfe  = c7 > 0 ? (s7 / math.max(1, c7)) * 100 : 0
    r7_mae  = c7 > 0 ? (m7 / math.max(1, c7)) * 100 : 0
    r7_avg  = c7 > 0 ? (a7 / math.max(1, c7)) * 100 : 0
    r14_mfe = c14 > 0 ? (s14 / math.max(1, c14)) * 100 : 0
    r14_mae = c14 > 0 ? (m14 / math.max(1, c14)) * 100 : 0
    r14_avg = c14 > 0 ? (a14 / math.max(1, c14)) * 100 : 0
    r30_mfe = c30 > 0 ? (s30 / math.max(1, c30)) * 100 : 0
    r30_mae = c30 > 0 ? (m30 / math.max(1, c30)) * 100 : 0
    r30_avg = c30 > 0 ? (a30 / math.max(1, c30)) * 100 : 0
    table.cell(tbl_id, 0, row, label, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl_id, 1, row, str.tostring(t_count), text_color=color.gray, text_size=size.small)
    table.cell(tbl_id, 2, row, "+" + str.tostring(math.round(r7_mfe, 2)) + "%", text_color=r7_mfe > 0 ? color.lime : color.gray, text_size=size.small)
    table.cell(tbl_id, 3, row, str.tostring(math.round(r7_mae, 2)) + "%", text_color=r7_mae < 0 ? color.red : color.gray, text_size=size.small)
    table.cell(tbl_id, 4, row, (r7_avg >= 0 ? "+" : "") + str.tostring(math.round(r7_avg, 2)) + "%", text_color=r7_avg >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(tbl_id, 5, row, "+" + str.tostring(math.round(r14_mfe, 2)) + "%", text_color=r14_mfe > 0 ? color.lime : color.gray, text_size=size.small)
    table.cell(tbl_id, 6, row, str.tostring(math.round(r14_mae, 2)) + "%", text_color=r14_mae < 0 ? color.red : color.gray, text_size=size.small)
    table.cell(tbl_id, 7, row, (r14_avg >= 0 ? "+" : "") + str.tostring(math.round(r14_avg, 2)) + "%", text_color=r14_avg >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(tbl_id, 8, row, "+" + str.tostring(math.round(r30_mfe, 2)) + "%", text_color=r30_mfe > 0 ? color.lime : color.gray, text_size=size.small)
    table.cell(tbl_id, 9, row, str.tostring(math.round(r30_mae, 2)) + "%", text_color=r30_mae < 0 ? color.red : color.gray, text_size=size.small)
    table.cell(tbl_id, 10, row, (r30_avg >= 0 ? "+" : "") + str.tostring(math.round(r30_avg, 2)) + "%", text_color=r30_avg >= 0 ? color.lime : color.red, text_size=size.small)

// TP/SL row renderer (must be global scope — Pine Script rule)
f_tpsl_row(t, row, lbl, tot, wins, tp_hits, sl_hits, sum_ret, bg) =>
    wr  = tot > 0 ? (wins / math.max(1, tot)) * 100 : 0.0
    avg = tot > 0 ? sum_ret * 100 / math.max(1, tot) : 0.0
    table.cell(t, 0, row, lbl,                                                             text_color=color.yellow,                       text_size=size.small, text_halign=text.align_left, bgcolor=bg)
    table.cell(t, 1, row, str.tostring(tot),                                               text_color=color.gray,                         text_size=size.small, bgcolor=bg)
    table.cell(t, 2, row, str.tostring(math.round(wr, 1)) + "%",                           text_color=wr  >= 55 ? color.lime : color.white, text_size=size.small, bgcolor=bg)
    table.cell(t, 3, row, (avg >= 0 ? "+" : "") + str.tostring(math.round(avg, 2)) + "%",  text_color=avg >= 0  ? color.lime : color.red,   text_size=size.small, bgcolor=bg)
    table.cell(t, 4, row, "TP:" + str.tostring(tp_hits),                                   text_color=color.lime,                         text_size=size.small, bgcolor=bg)
    table.cell(t, 5, row, "SL:" + str.tostring(sl_hits),                                   text_color=color.red,                          text_size=size.small, bgcolor=bg)
    // Span empty space to cover the expanded 11-column layout
    table.merge_cells(t, 6, row, 10, row)
    table.cell(t, 6, row, "", bgcolor=bg)
    table.merge_cells(t, 0, row, 1, row)



if show_backtest
    // ── V3 Signal Computation (legacy daily-only path) ────────────────────────
    c_wk_score = request.security(syminfo.tickerid, "W", s_calc_weekly_score(sc_mb_len, sc_mb_len2, sc_mb_len3))
    [v3_c, v3_s, v3_sn, v3_st, v3_sc, v3_mb, v3_bxs, v3_bxl, v3_d1, v3_d2, v3_rev, v3_rvol, v3_reg, v3_oe, v3_adx, v3_ms, v3_pq] =
     s_get_data_v3(w_mb, w_bxs, w_bxl, w_ema, w_mom, w_adx, w_vol,
            sc_mb_len, sc_mb_len2, sc_mb_len3, sc_bx_s1, sc_bx_s2, sc_bx_s3,
            sc_bx_l1, sc_bx_l2, ema_len1, ema_len2, ema_len3)
    v3_mtf = use_mtf_filter and ((v3_st == "CALL" and c_wk_score < mtf_score_floor) or (v3_st == "PUT" and c_wk_score > 52))
    if v3_mtf
        if v3_st == "PUT"
            v3_s := c_wk_score > 62 ? "⬆️ PULLBACK" : c_wk_score > 55 ? "⚡ REBOUND RISK" : "🟡 BRKDWN WATCH"
        else if v3_st == "CALL"
            v3_s := c_wk_score < 38 ? "🐻 BEAR TREND" : c_wk_score < 45 ? "⚡ RALLY RISK" : "👀 NEUT WATCH"
        else
            v3_s := "⬆️ MTF BLOCK"

    // ── V4 Signal Computation (4H + Daily HTF + Weekly HTF) ──────────────────
    // Daily and Weekly data for current chart symbol at each bar
    [dbt_trend, dbt_struct, dbt_dir, dbt_sn, dbt_st, dbt_sc, dbt_adx, dbt_e21, dbt_d1, dbt_mb, dbt_bxs, dbt_bxl, dbt_sqz] =
     request.security(syminfo.tickerid, "D",
            s_calc_daily_htf(sc_mb_len, sc_mb_len2, sc_mb_len3,
                sc_bx_s1, sc_bx_s2, sc_bx_s3, sc_bx_l1, sc_bx_l2,
                ema_len1, ema_len2, ema_len3))
    [wkbt_score, wkbt_dir] =
     request.security(syminfo.tickerid, "W",
            s_calc_weekly_htf(sc_mb_len, sc_mb_len2, sc_mb_len3,
                sc_bx_s1, sc_bx_s2, sc_bx_s3, sc_bx_l1, sc_bx_l2,
                ema_len1, ema_len2, ema_len3))
    [v4_c, v4_s, v4_sn, v4_st, v4_sc, v4_mb, v4_bxs, v4_bxl, v4_d1, v4_d2, v4_rev, v4_rvol, v4_reg, v4_oe, v4_adx, v4_ms, v4_pq] =
     s_get_data_v4(
            nz(dbt_trend, 50.0), nz(dbt_struct, 50.0), nz(dbt_dir, 0.0),
            (na(dbt_sn) ? "" : dbt_sn), (na(dbt_st) ? "NEUTRAL" : dbt_st), nz(dbt_sc, 1),
            nz(dbt_adx, 20.0), nz(dbt_e21, close), nz(dbt_d1, 0.0),
            nz(dbt_mb, 0.0), nz(dbt_bxs, 0.0), nz(dbt_bxl, 0.0), false,
            nz(wkbt_score, 50.0), nz(wkbt_dir, 0.0),
            sc_mb_len, sc_mb_len2, sc_mb_len3,
            sc_bx_s1, sc_bx_s2, sc_bx_s3, sc_bx_l1, sc_bx_l2)

    // ── Select active signal based on scoring mode ────────────────────────────
    c_comp      = use_v4_scoring ? v4_c    : v3_c
    c_sig       = use_v4_scoring ? v4_s    : v3_s
    c_setup     = use_v4_scoring ? v4_sn   : v3_sn
    c_stype     = use_v4_scoring ? v4_st   : v3_st
    c_conf      = use_v4_scoring ? v4_sc   : v3_sc
    c_mb        = use_v4_scoring ? v4_mb   : v3_mb
    c_bxs       = use_v4_scoring ? v4_bxs  : v3_bxs
    c_bxl       = use_v4_scoring ? v4_bxl  : v3_bxl
    c_d1        = use_v4_scoring ? v4_d1   : v3_d1
    c_d2        = use_v4_scoring ? v4_d2   : v3_d2
    c_rev       = use_v4_scoring ? v4_rev  : v3_rev
    c_rvol      = use_v4_scoring ? v4_rvol : v3_rvol
    c_regime    = use_v4_scoring ? v4_reg  : v3_reg
    c_overext   = use_v4_scoring ? v4_oe   : v3_oe
    c_adx       = use_v4_scoring ? v4_adx  : v3_adx
    c_mkt_state = use_v4_scoring ? v4_ms   : v3_ms
    c_pb_qual   = use_v4_scoring ? v4_pq   : v3_pq
    c_mtf       = use_v4_scoring ? false   : v3_mtf

    // Enforce Time Limit (1 year = ~31,536,000,000 ms)
    is_within_time_limit = time >= (timenow - (max_bt_years * 31536000000))
    is_valid_sig = c_comp >= math.max(min_score_bt, 70) and (c_stype == "CALL" or c_stype == "PUT") and is_within_time_limit

    // Persistent stats — Overall
    var int bt_bars_tested = 0
    if is_within_time_limit
        bt_bars_tested += 1
        
    var int total_signals = 0
    var int c7_total = 0, var float success_7 = 0.0, var float sum_m7_total = 0.0, var float a7_total = 0.0
    var int c14_total = 0, var float success_14 = 0.0, var float sum_m14_total = 0.0, var float a14_total = 0.0
    var int c30_total = 0, var float success_30 = 0.0, var float sum_m30_total = 0.0, var float a30_total = 0.0
    // Strategy Breakdown — CALL
    var int t_calls = 0, var int c7_calls = 0, var float s7_calls = 0.0, var float sum_m7_calls = 0.0, var float a7_calls = 0.0
    var int c14_calls = 0, var float s14_calls = 0.0, var float sum_m14_calls = 0.0, var float a14_calls = 0.0
    var int c30_calls = 0, var float s30_calls = 0.0, var float sum_m30_calls = 0.0, var float a30_calls = 0.0
    // Strategy Breakdown — PUT
    var int t_puts = 0, var int c7_puts = 0, var float s7_puts = 0.0, var float sum_m7_puts = 0.0, var float a7_puts = 0.0
    var int c14_puts = 0, var float s14_puts = 0.0, var float sum_m14_puts = 0.0, var float a14_puts = 0.0
    var int c30_puts = 0, var float s30_puts = 0.0, var float sum_m30_puts = 0.0, var float a30_puts = 0.0
    // Filtered Breakdown
    var int t_filt = 0, var int c7_filt = 0, var float s7_filt = 0.0, var float sum_m7_filt = 0.0, var float a7_filt = 0.0
    var int c14_filt = 0, var float s14_filt = 0.0, var float sum_m14_filt = 0.0, var float a14_filt = 0.0
    var int c30_filt = 0, var float s30_filt = 0.0, var float sum_m30_filt = 0.0, var float a30_filt = 0.0
    // Simplified Tier Breakdown — CALL (S, A, B)
    var int t_call_s = 0, var int c7_call_s = 0, var float s7_call_s = 0.0, var float sum_m7_call_s = 0.0, var float a7_call_s = 0.0, var int c14_call_s = 0, var float s14_call_s = 0.0, var float sum_m14_call_s = 0.0, var float a14_call_s = 0.0, var int c20_call_s = 0, var float s20_call_s = 0.0, var float sum_m20_call_s = 0.0, var float a20_call_s = 0.0
    var int t_call_a = 0, var int c7_call_a = 0, var float s7_call_a = 0.0, var float sum_m7_call_a = 0.0, var float a7_call_a = 0.0, var int c14_call_a = 0, var float s14_call_a = 0.0, var float sum_m14_call_a = 0.0, var float a14_call_a = 0.0, var int c20_call_a = 0, var float s20_call_a = 0.0, var float sum_m20_call_a = 0.0, var float a20_call_a = 0.0
    var int t_call_b = 0, var int c7_call_b = 0, var float s7_call_b = 0.0, var float sum_m7_call_b = 0.0, var float a7_call_b = 0.0, var int c14_call_b = 0, var float s14_call_b = 0.0, var float sum_m14_call_b = 0.0, var float a14_call_b = 0.0, var int c20_call_b = 0, var float s20_call_b = 0.0, var float sum_m20_call_b = 0.0, var float a20_call_b = 0.0
    
    // Simplified Tier Breakdown — PUT (S, A, B)
    var int t_put_s = 0, var int c7_put_s = 0, var float s7_put_s = 0.0, var float sum_m7_put_s = 0.0, var float a7_put_s = 0.0, var int c14_put_s = 0, var float s14_put_s = 0.0, var float sum_m14_put_s = 0.0, var float a14_put_s = 0.0, var int c20_put_s = 0, var float s20_put_s = 0.0, var float sum_m20_put_s = 0.0, var float a20_put_s = 0.0
    var int t_put_a = 0, var int c7_put_a = 0, var float s7_put_a = 0.0, var float sum_m7_put_a = 0.0, var float a7_put_a = 0.0, var int c14_put_a = 0, var float s14_put_a = 0.0, var float sum_m14_put_a = 0.0, var float a14_put_a = 0.0, var int c20_put_a = 0, var float s20_put_a = 0.0, var float sum_m20_put_a = 0.0, var float a20_put_a = 0.0
    var int t_put_b = 0, var int c7_put_b = 0, var float s7_put_b = 0.0, var float sum_m7_put_b = 0.0, var float a7_put_b = 0.0, var int c14_put_b = 0, var float s14_put_b = 0.0, var float sum_m14_put_b = 0.0, var float a14_put_b = 0.0, var int c20_put_b = 0, var float s20_put_b = 0.0, var float sum_m20_put_b = 0.0, var float a20_put_b = 0.0
    
    // Check local blocker rules
    c_block_msg = f_get_blocker(c_regime, c_rvol, rvol_threshold, c_overext, c_mtf)
    
    // Determine blocker status per type
    is_wait    = str.startswith(c_block_msg, "⏳")
    is_overext = str.contains(c_block_msg, "OverExt")
    is_mtf     = str.contains(c_block_msg, "MTF")
    
    // A setup is "valid" if it's NOT blocked by an enabled filter
    has_valid_struct = true
    if bt_filt_wait and is_wait
        has_valid_struct := false
    if bt_filt_overext and is_overext
        has_valid_struct := false
    // [v3.3] Exclude EXTENDED pullback-chase entries — these now emit WAIT PB, not BUY/SELL
    if bt_filt_pb_ext and c_pb_qual == "EXTENDED"
        has_valid_struct := false
    if bt_filt_mtf and is_mtf
        has_valid_struct := false
    if str.startswith(c_block_msg, "—")
        has_valid_struct := false
    
    // Trigger condition
    is_any_sig = (is_valid_sig and has_valid_struct)

    // Track active signals
    var float[] signal_entry_prices = array.new_float(0)
    var int[]   signal_entry_bars   = array.new_int(0)
    var string[] signal_types       = array.new_string(0)
    var string[] signal_setups      = array.new_string(0)
    var string[] signal_tiers       = array.new_string(0)
    var string[] signal_regimes     = array.new_string(0)  // Market regime at entry
    var int     last_entry_idx      = -100
    
    // TP/SL tracking arrays (parallel to above)
    var float[] signal_tp_prices    = array.new_float(0)  // price level for TP
    var float[] signal_sl_prices    = array.new_float(0)  // price level for SL
    var bool[]  signal_closed       = array.new_bool(0)   // already exited via TP or SL?
    var float[] signal_atr_val      = array.new_float(0)  // track ATR at entry
    
    // TP/SL simulation stats — OVERALL
    var int   tpsl_total   = 0
    var int   tpsl_wins    = 0
    var int   tpsl_tp_hits = 0
    var int   tpsl_sl_hits = 0
    var float tpsl_sum_ret = 0.0
    // TP/SL — CALL breakdown
    var int   tpsl_call_total = 0, var int tpsl_call_wins = 0
    var int   tpsl_call_tp   = 0,  var int tpsl_call_sl   = 0
    var float tpsl_call_ret  = 0.0
    // TP/SL — PUT breakdown
    var int   tpsl_put_total = 0,  var int tpsl_put_wins  = 0
    var int   tpsl_put_tp    = 0,  var int tpsl_put_sl    = 0
    var float tpsl_put_ret   = 0.0
    // TP/SL — Directional Tier breakdown (Call)
    var int tpsl_c_s_tot = 0, var int tpsl_c_s_win = 0, var int tpsl_c_s_tp = 0, var int tpsl_c_s_sl = 0, var float tpsl_c_s_ret = 0.0
    var int tpsl_c_a_tot = 0, var int tpsl_c_a_win = 0, var int tpsl_c_a_tp = 0, var int tpsl_c_a_sl = 0, var float tpsl_c_a_ret = 0.0
    var int tpsl_c_b_tot = 0, var int tpsl_c_b_win = 0, var int tpsl_c_b_tp = 0, var int tpsl_c_b_sl = 0, var float tpsl_c_b_ret = 0.0
    // TP/SL — Directional Tier breakdown (Put)
    var int tpsl_p_s_tot = 0, var int tpsl_p_s_win = 0, var int tpsl_p_s_tp = 0, var int tpsl_p_s_sl = 0, var float tpsl_p_s_ret = 0.0
    var int tpsl_p_a_tot = 0, var int tpsl_p_a_win = 0, var int tpsl_p_a_tp = 0, var int tpsl_p_a_sl = 0, var float tpsl_p_a_ret = 0.0
    var int tpsl_p_b_tot = 0, var int tpsl_p_b_win = 0, var int tpsl_p_b_tp = 0, var int tpsl_p_b_sl = 0, var float tpsl_p_b_ret = 0.0

    // Option A Logic: Trigger on NEW signal OR every 21 bars of persistent signal
    is_new_status = (c_sig != c_sig[1])
    is_cooldown_expired = (bar_index - last_entry_idx >= 21)
    
    trigger_trade_cond = is_any_sig and (is_new_status or is_cooldown_expired)

    // NEW (v3.3): Enter on the OPEN of the bar following the signal to simulate realistic execution
    trigger_trade = trigger_trade_cond[1]

    if trigger_trade
        last_entry_idx := bar_index
        entry_price = open
        array.push(signal_entry_prices, entry_price)
        array.push(signal_entry_bars,   bar_index)
        array.push(signal_types,        c_stype[1])
        array.push(signal_setups,       c_setup[1])
        effective_score = c_comp[1]
        tier = effective_score >= 90 ? "S" : effective_score >= 80 ? "A" : "B"
        array.push(signal_tiers,        tier)
        array.push(signal_regimes,      c_regime[1])  // Store regime at entry
        array.push(signal_closed,       false)
        
        entry_atr = ta.atr(14)[1]
        array.push(signal_atr_val,      entry_atr)

        // Dynamic TP/SL based on entry context (v4) or fixed multipliers (v3)
        // v4: OPTIMAL entry → tighter stop, wider target (entered at support)
        //     CHASING entry → wider stop, tighter target (entered late)
        bt_eq_norm = use_v4_scoring and not na(c_pb_qual[1]) ?
             (c_pb_qual[1] == "OPTIMAL"    ? 0.75 :
              c_pb_qual[1] == "ACCEPTABLE" ? 0.25 :
              c_pb_qual[1] == "MARGINAL"   ? -0.10 : -0.40) : 0.0
        eff_tp = tp_atr * (1.0 + bt_eq_norm * 0.25)
        eff_sl = sl_atr * (1.0 - bt_eq_norm * 0.30)

        // Set TP/SL levels based on signal direction using effective ATR multipliers
        if c_stype[1] == "CALL"
            array.push(signal_tp_prices, entry_price + (entry_atr * eff_tp))
            array.push(signal_sl_prices, entry_price - (entry_atr * eff_sl))
        else  // PUT
            array.push(signal_tp_prices, entry_price - (entry_atr * eff_tp))
            array.push(signal_sl_prices, entry_price + (entry_atr * eff_sl))
        
        total_signals += 1
        prev_stype = c_stype[1]
        if prev_stype == "CALL"
            t_calls += 1
        else if prev_stype == "PUT"
            t_puts += 1
            
        // Tier counts: DIRECTIONAL trades only
        if prev_stype == "CALL"
            if tier == "S"
                t_call_s += 1
            else if tier == "A"
                t_call_a += 1
            else
                t_call_b += 1
        else if prev_stype == "PUT"
            if tier == "S"
                t_put_s += 1
            else if tier == "A"
                t_put_a += 1
            else
                t_put_b += 1

        prev_setup = c_setup[1]
        if setup_filt_bt == "All" or str.contains(prev_setup, setup_filt_bt)
            t_filt += 1

    // Pre-calculate window extremes to avoid history-in-loop restrictions
    bt_h_0 = ta.highest(high, look_fwd_0 + 1)
    bt_l_0 = ta.lowest(low, look_fwd_0 + 1)
    bt_h_1 = ta.highest(high, look_fwd_1 + 1)
    bt_l_1 = ta.lowest(low, look_fwd_1 + 1)
    bt_h_2 = ta.highest(high, look_fwd_2 + 1)
    bt_l_2 = ta.lowest(low, look_fwd_2 + 1)

    // Check performance for all pending signals
    if array.size(signal_entry_bars) > 0
        for i = array.size(signal_entry_bars) - 1 to 0
            e_bar    = array.get(signal_entry_bars, i)
            e_price  = array.get(signal_entry_prices, i)
            e_type   = array.get(signal_types, i)
            e_setup  = array.get(signal_setups, i)
            e_tier   = array.get(signal_tiers, i)
            e_regime = array.get(signal_regimes, i)
            e_closed = array.get(signal_closed, i)
            e_tp     = array.get(signal_tp_prices, i)
            e_sl     = array.get(signal_sl_prices, i)
            diff     = bar_index - e_bar
            
            is_match = setup_filt_bt == "All" or str.contains(e_setup, setup_filt_bt)

            // ── TP/SL Check: runs on EVERY bar, takes priority
            if use_tpsl and not e_closed
                tp_hit = false
                sl_hit = false
                time_stop_hit = false
                e_atr = array.get(signal_atr_val, i)

                float execution_price = close
                float sl_slippage_price = e_sl

                if diff >= time_stop_bars
                    time_stop_hit := true
                else
                    if e_type == "CALL"
                        tp_triggered = high >= e_tp
                        sl_triggered = low <= e_sl
                        // Check Gap Slippage on SL
                        if open < e_sl
                            sl_hit := true
                            sl_slippage_price := open
                        else if tp_triggered and sl_triggered
                            // Conservative: if both hit same bar, prioritize SL (worst case)
                            sl_hit := true
                            sl_slippage_price := e_sl
                        else if tp_triggered
                            tp_hit := true
                            execution_price := e_tp
                        else if sl_triggered
                            sl_hit := true
                            sl_slippage_price := e_sl
                    else  // PUT
                        tp_triggered = low <= e_tp   // TP for PUT = underlying dropped enough
                        sl_triggered = high >= e_sl  // SL for PUT = underlying rose above sl
                        // Check Gap Slippage on SL
                        if open > e_sl
                            sl_hit := true
                            sl_slippage_price := open
                        else if tp_triggered and sl_triggered
                            // Conservative: if both hit same bar, prioritize SL (worst case)
                            sl_hit := true
                            sl_slippage_price := e_sl
                        else if tp_triggered
                            tp_hit := true
                            execution_price := e_tp
                        else if sl_triggered
                            sl_hit := true
                            sl_slippage_price := e_sl
                
                if tp_hit or sl_hit or time_stop_hit
                    array.set(signal_closed, i, true)
                    float ret_val = 0.0
                    if time_stop_hit
                        ret_val := (e_type == "CALL" ? (close - e_price) : (e_price - close)) / math.max(e_price, 0.01)
                    else if tp_hit
                        ret_val := (e_type == "CALL" ? (execution_price - e_price) : (e_price - execution_price)) / math.max(e_price, 0.01)
                    else if sl_hit
                        ret_val := (e_type == "CALL" ? (sl_slippage_price - e_price) : (e_price - sl_slippage_price)) / math.max(e_price, 0.01)

                    tpsl_total   += 1
                    tpsl_sum_ret += ret_val
                    is_win = ret_val > 0
                    if tp_hit
                        tpsl_wins    += 1
                        tpsl_tp_hits += 1
                    else if sl_hit
                        tpsl_sl_hits += 1
                    else if time_stop_hit and is_win
                        tpsl_wins += 1    

                    // Per-category breakdown
                    if e_type == "CALL"
                        tpsl_call_total += 1
                        tpsl_call_ret   += ret_val
                        if tp_hit
                            tpsl_call_wins += 1
                            tpsl_call_tp   += 1
                        else if sl_hit
                            tpsl_call_sl += 1
                        else if time_stop_hit and is_win
                            tpsl_call_wins += 1
                    else if e_type == "PUT"
                        tpsl_put_total += 1
                        tpsl_put_ret   += ret_val
                        if tp_hit
                            tpsl_put_wins += 1
                            tpsl_put_tp   += 1
                        else if sl_hit
                            tpsl_put_sl += 1
                        else if time_stop_hit and is_win
                            tpsl_put_wins += 1

                            
                    if e_type == "CALL"
                        if e_tier == "S"
                            tpsl_c_s_tot += 1
                            tpsl_c_s_ret += ret_val
                            if tp_hit
                                tpsl_c_s_win += 1
                                tpsl_c_s_tp  += 1
                            else if sl_hit
                                tpsl_c_s_sl  += 1
                            else if time_stop_hit and is_win
                                tpsl_c_s_win += 1
                        else if e_tier == "A"
                            tpsl_c_a_tot += 1
                            tpsl_c_a_ret += ret_val
                            if tp_hit
                                tpsl_c_a_win += 1
                                tpsl_c_a_tp  += 1
                            else if sl_hit
                                tpsl_c_a_sl  += 1
                            else if time_stop_hit and is_win
                                tpsl_c_a_win += 1
                        else if e_tier == "B"
                            tpsl_c_b_tot += 1
                            tpsl_c_b_ret += ret_val
                            if tp_hit
                                tpsl_c_b_win += 1
                                tpsl_c_b_tp  += 1
                            else if sl_hit
                                tpsl_c_b_sl  += 1
                            else if time_stop_hit and is_win
                                tpsl_c_b_win += 1
                    else if e_type == "PUT"
                        if e_tier == "S"
                            tpsl_p_s_tot += 1
                            tpsl_p_s_ret += ret_val
                            if tp_hit
                                tpsl_p_s_win += 1
                                tpsl_p_s_tp  += 1
                            else if sl_hit
                                tpsl_p_s_sl  += 1
                            else if time_stop_hit and is_win
                                tpsl_p_s_win += 1
                        else if e_tier == "A"
                            tpsl_p_a_tot += 1
                            tpsl_p_a_ret += ret_val
                            if tp_hit
                                tpsl_p_a_win += 1
                                tpsl_p_a_tp  += 1
                            else if sl_hit
                                tpsl_p_a_sl  += 1
                            else if time_stop_hit and is_win
                                tpsl_p_a_win += 1
                        else if e_tier == "B"
                            tpsl_p_b_tot += 1
                            tpsl_p_b_ret += ret_val
                            if tp_hit
                                tpsl_p_b_win += 1
                                tpsl_p_b_tp  += 1
                            else if sl_hit
                                tpsl_p_b_sl  += 1
                            else if time_stop_hit and is_win
                                tpsl_p_b_win += 1

            if diff == look_fwd_0
                trade_mfe = e_type == "CALL" ? (bt_h_0 - e_price) / e_price : (e_price - bt_l_0) / e_price
                trade_mae = e_type == "CALL" ? (bt_l_0 - e_price) / e_price : (e_price - bt_h_0) / e_price
                trade_avg = e_type == "CALL" ? (close - e_price) / e_price : (e_price - close) / e_price
                
                c7_total += 1
                success_7 += trade_mfe
                sum_m7_total += trade_mae
                a7_total += trade_avg
                
                if e_type == "CALL" 
                    c7_calls += 1
                    s7_calls += trade_mfe
                    sum_m7_calls += trade_mae
                    a7_calls += trade_avg
                else 
                    c7_puts += 1
                    s7_puts += trade_mfe
                    sum_m7_puts += trade_mae
                    a7_puts += trade_avg
                
                if is_match
                    c7_filt += 1
                    s7_filt += trade_mfe
                    sum_m7_filt += trade_mae
                    a7_filt += trade_avg
                
                if e_type == "CALL"
                    if e_tier == "S"
                        c7_call_s += 1
                        s7_call_s += trade_mfe
                        sum_m7_call_s += trade_mae
                        a7_call_s += trade_avg
                    else if e_tier == "A"
                        c7_call_a += 1
                        s7_call_a += trade_mfe
                        sum_m7_call_a += trade_mae
                        a7_call_a += trade_avg
                    else if e_tier == "B"
                        c7_call_b += 1
                        s7_call_b += trade_mfe
                        sum_m7_call_b += trade_mae
                        a7_call_b += trade_avg
                else if e_type == "PUT"
                    if e_tier == "S"
                        c7_put_s += 1
                        s7_put_s += trade_mfe
                        sum_m7_put_s += trade_mae
                        a7_put_s += trade_avg
                    else if e_tier == "A"
                        c7_put_a += 1
                        s7_put_a += trade_mfe
                        sum_m7_put_a += trade_mae
                        a7_put_a += trade_avg
                    else if e_tier == "B"
                        c7_put_b += 1
                        s7_put_b += trade_mfe
                        sum_m7_put_b += trade_mae
                        a7_put_b += trade_avg

            if diff == look_fwd_1
                trade_mfe = e_type == "CALL" ? (bt_h_1 - e_price) / e_price : (e_price - bt_l_1) / e_price
                trade_mae = e_type == "CALL" ? (bt_l_1 - e_price) / e_price : (e_price - bt_h_1) / e_price
                trade_avg = e_type == "CALL" ? (close - e_price) / e_price : (e_price - close) / e_price
                
                c14_total += 1
                success_14 += trade_mfe
                sum_m14_total += trade_mae
                a14_total += trade_avg
                
                if e_type == "CALL" 
                    c14_calls += 1
                    s14_calls += trade_mfe
                    sum_m14_calls += trade_mae
                    a14_calls += trade_avg
                else 
                    c14_puts += 1
                    s14_puts += trade_mfe
                    sum_m14_puts += trade_mae
                    a14_puts += trade_avg
                
                if is_match
                    c14_filt += 1
                    s14_filt += trade_mfe
                    sum_m14_filt += trade_mae
                    a14_filt += trade_avg
                
                if e_type == "CALL"
                    if e_tier == "S"
                        c14_call_s += 1
                        s14_call_s += trade_mfe
                        sum_m14_call_s += trade_mae
                        a14_call_s += trade_avg
                    else if e_tier == "A"
                        c14_call_a += 1
                        s14_call_a += trade_mfe
                        sum_m14_call_a += trade_mae
                        a14_call_a += trade_avg
                    else if e_tier == "B"
                        c14_call_b += 1
                        s14_call_b += trade_mfe
                        sum_m14_call_b += trade_mae
                        a14_call_b += trade_avg
                else if e_type == "PUT"
                    if e_tier == "S"
                        c14_put_s += 1
                        s14_put_s += trade_mfe
                        sum_m14_put_s += trade_mae
                        a14_put_s += trade_avg
                    else if e_tier == "A"
                        c14_put_a += 1
                        s14_put_a += trade_mfe
                        sum_m14_put_a += trade_mae
                        a14_put_a += trade_avg
                    else if e_tier == "B"
                        c14_put_b += 1
                        s14_put_b += trade_mfe
                        sum_m14_put_b += trade_mae
                        a14_put_b += trade_avg

            if diff == look_fwd_2
                trade_mfe = e_type == "CALL" ? (bt_h_2 - e_price) / e_price : (e_price - bt_l_2) / e_price
                trade_mae = e_type == "CALL" ? (bt_l_2 - e_price) / e_price : (e_price - bt_h_2) / e_price
                trade_avg = e_type == "CALL" ? (close - e_price) / e_price : (e_price - close) / e_price
                
                c30_total += 1
                success_30 += trade_mfe
                sum_m30_total += trade_mae
                a30_total += trade_avg
                
                if e_type == "CALL" 
                    c30_calls += 1
                    s30_calls += trade_mfe
                    sum_m30_calls += trade_mae
                    a30_calls += trade_avg
                else 
                    c30_puts += 1
                    s30_puts += trade_mfe
                    sum_m30_puts += trade_mae
                    a30_puts += trade_avg
                
                if is_match
                    c30_filt += 1
                    s30_filt += trade_mfe
                    sum_m30_filt += trade_mae
                    a30_filt += trade_avg
                
                if e_type == "CALL"
                    if e_tier == "S"
                        c20_call_s += 1
                        s20_call_s += trade_mfe
                        sum_m20_call_s += trade_mae
                        a20_call_s += trade_avg
                    else if e_tier == "A"
                        c20_call_a += 1
                        s20_call_a += trade_mfe
                        sum_m20_call_a += trade_mae
                        a20_call_a += trade_avg
                    else if e_tier == "B"
                        c20_call_b += 1
                        s20_call_b += trade_mfe
                        sum_m20_call_b += trade_mae
                        a20_call_b += trade_avg
                else if e_type == "PUT"
                    if e_tier == "S"
                        c20_put_s += 1
                        s20_put_s += trade_mfe
                        sum_m20_put_s += trade_mae
                        a20_put_s += trade_avg
                    else if e_tier == "A"
                        c20_put_a += 1
                        s20_put_a += trade_mfe
                        sum_m20_put_a += trade_mae
                        a20_put_a += trade_avg
                    else if e_tier == "B"
                        c20_put_b += 1
                        s20_put_b += trade_mfe
                        sum_m20_put_b += trade_mae
                        a20_put_b += trade_avg
            
            // [FIX-7] Cleanup
            should_remove = false
            if use_tpsl
                should_remove := diff >= math.max(look_fwd_2, time_stop_bars + 1)
            else
                should_remove := diff >= look_fwd_2
                
            if should_remove
                array.remove(signal_entry_bars,   i)
                array.remove(signal_entry_prices, i)
                array.remove(signal_types,        i)
                array.remove(signal_setups,       i)
                array.remove(signal_tiers,        i)
                array.remove(signal_regimes,      i)
                array.remove(signal_closed,       i)
                array.remove(signal_tp_prices,    i)
                array.remove(signal_sl_prices,    i)
                array.remove(signal_atr_val,      i)

    // Display Stats Table
    if barstate.islast
        bt_tbl_pos = bt_pos == "top_right" ? position.top_right : bt_pos == "top_left" ? position.top_left : bt_pos == "bottom_right" ? position.bottom_right : bt_pos == "bottom_left" ? position.bottom_left : bt_pos == "top_center" ? position.top_center : position.bottom_center
        var table bt_tbl = table.new(bt_tbl_pos, 11, 30, bgcolor=color.new(color.black, 40), border_width=1, border_color=color.gray)
        
        bt_title = "Signal Quality: " + syminfo.ticker + (setup_filt_bt == "All" ? "" : " [" + setup_filt_bt + "]") + " (" + str.tostring(bt_bars_tested) + " bars · Underlying move, not option PnL)"
        table.merge_cells(bt_tbl, 0, 0, 10, 0)
        table.cell(bt_tbl, 0, 0, bt_title, text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))

        // Sample size reliability banner
        sample_ok    = total_signals >= 30
        sample_warn  = total_signals >= 15 and total_signals < 30
        sample_note  = total_signals < 15  ? "⚠️ UNRELIABLE — only " + str.tostring(total_signals) + " signals. Turn off filters or use more data." :
                       total_signals < 30  ? "⚠️ Low sample (" + str.tostring(total_signals) + "). Results directional only — disable some BT Filt to improve." :
                                             "✅ Sample OK (" + str.tostring(total_signals) + " signals)"
        sample_bg    = total_signals < 15 ? color.new(color.red, 60) : total_signals < 30 ? color.new(color.orange, 70) : color.new(color.green, 80)
        table.merge_cells(bt_tbl, 0, 1, 10, 1)
        table.cell(bt_tbl, 0, 1, sample_note, text_color=color.white, text_size=size.tiny, bgcolor=sample_bg)

        table.cell(bt_tbl, 0, 2, "Category", text_color=color.gray, text_size=size.tiny)
        table.cell(bt_tbl, 1, 2, "Count",    text_color=color.gray, text_size=size.tiny)
        table.cell(bt_tbl, 2, 2, "Max Fav " + str.tostring(look_fwd_0) + "d", text_color=color.gray, text_size=size.tiny)
        table.cell(bt_tbl, 3, 2, "Max Adv " + str.tostring(look_fwd_0) + "d", text_color=color.gray, text_size=size.tiny)
        table.cell(bt_tbl, 4, 2, "Avg " + str.tostring(look_fwd_0) + "d", text_color=color.gray, text_size=size.tiny)
        table.cell(bt_tbl, 5, 2, "Max Fav " + str.tostring(look_fwd_1) + "d", text_color=color.gray, text_size=size.tiny)
        table.cell(bt_tbl, 6, 2, "Max Adv " + str.tostring(look_fwd_1) + "d", text_color=color.gray, text_size=size.tiny)
        table.cell(bt_tbl, 7, 2, "Avg " + str.tostring(look_fwd_1) + "d", text_color=color.gray, text_size=size.tiny)
        table.cell(bt_tbl, 8, 2, "Max Fav " + str.tostring(look_fwd_2) + "d", text_color=color.gray, text_size=size.tiny)
        table.cell(bt_tbl, 9, 2, "Max Adv " + str.tostring(look_fwd_2) + "d", text_color=color.gray, text_size=size.tiny)
        table.cell(bt_tbl, 10, 2, "Avg " + str.tostring(look_fwd_2) + "d", text_color=color.gray, text_size=size.tiny)
        
        // --- CALL SECTION ---
        table.merge_cells(bt_tbl, 0, 3, 10, 3)
        table.cell(bt_tbl, 0, 3, "CALL STRATEGIES", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.green, 70))
        
        f_draw_bt_row(bt_tbl, 4, "CALL Only (ALL)", t_calls, c7_calls, s7_calls,  sum_m7_calls, a7_calls, c14_calls, s14_calls,  sum_m14_calls, a14_calls, c30_calls, s30_calls,   sum_m30_calls, a30_calls)
        f_draw_bt_row(bt_tbl, 5, "└ S(90+) Call",  t_call_s, c7_call_s, s7_call_s, sum_m7_call_s, a7_call_s, c14_call_s, s14_call_s, sum_m14_call_s, a14_call_s, c20_call_s, s20_call_s, sum_m20_call_s, a20_call_s)
        f_draw_bt_row(bt_tbl, 6, "└ A(80+) Call",  t_call_a, c7_call_a, s7_call_a, sum_m7_call_a, a7_call_a, c14_call_a, s14_call_a, sum_m14_call_a, a14_call_a, c20_call_a, s20_call_a, sum_m20_call_a, a20_call_a)
        f_draw_bt_row(bt_tbl, 7, "└ B(70+) Call",  t_call_b, c7_call_b, s7_call_b, sum_m7_call_b, a7_call_b, c14_call_b, s14_call_b, sum_m14_call_b, a14_call_b, c20_call_b, s20_call_b, sum_m20_call_b, a20_call_b)
        
        if use_tpsl
            tpsl_lbl = "TP" + str.tostring(tp_atr) + "A/SL" + str.tostring(sl_atr) + "A"
            bg_c = color.new(color.green, 92)
            f_tpsl_row(bt_tbl, 8,  tpsl_lbl + " S Call", tpsl_c_s_tot, tpsl_c_s_win, tpsl_c_s_tp, tpsl_c_s_sl, tpsl_c_s_ret, bg_c)
            f_tpsl_row(bt_tbl, 9,  tpsl_lbl + " A Call", tpsl_c_a_tot, tpsl_c_a_win, tpsl_c_a_tp, tpsl_c_a_sl, tpsl_c_a_ret, bg_c)
            f_tpsl_row(bt_tbl, 10, tpsl_lbl + " B Call", tpsl_c_b_tot, tpsl_c_b_win, tpsl_c_b_tp, tpsl_c_b_sl, tpsl_c_b_ret, bg_c)
            // TP/SL Call Total summary
            f_tpsl_row(bt_tbl, 11, "► " + tpsl_lbl + " CALL", tpsl_call_total, tpsl_call_wins, tpsl_call_tp, tpsl_call_sl, tpsl_call_ret, color.new(color.green, 80))

        // --- PUT SECTION ---
        table.merge_cells(bt_tbl, 0, 12, 10, 12)
        table.cell(bt_tbl, 0, 12, "PUT STRATEGIES", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.red, 70))

        f_draw_bt_row(bt_tbl, 13, "PUT Only (ALL)",  t_puts,  c7_puts,  s7_puts,   sum_m7_puts, a7_puts,  c14_puts,  s14_puts,   sum_m14_puts, a14_puts,  c30_puts,  s30_puts,    sum_m30_puts, a30_puts)
        f_draw_bt_row(bt_tbl, 14, "└ S(90+) Put",   t_put_s, c7_put_s, s7_put_s, sum_m7_put_s, a7_put_s, c14_put_s, s14_put_s, sum_m14_put_s, a14_put_s, c20_put_s, s20_put_s, sum_m20_put_s, a20_put_s)
        f_draw_bt_row(bt_tbl, 15, "└ A(80+) Put",   t_put_a, c7_put_a, s7_put_a, sum_m7_put_a, a7_put_a, c14_put_a, s14_put_a, sum_m14_put_a, a14_put_a, c20_put_a, s20_put_a, sum_m20_put_a, a20_put_a)
        f_draw_bt_row(bt_tbl, 16, "└ B(70+) Put",   t_put_b, c7_put_b, s7_put_b, sum_m7_put_b, a7_put_b, c14_put_b, s14_put_b, sum_m14_put_b, a14_put_b, c20_put_b, s20_put_b, sum_m20_put_b, a20_put_b)

        if use_tpsl
            tpsl_lbl = "TP" + str.tostring(tp_atr) + "A/SL" + str.tostring(sl_atr) + "A"
            bg_p = color.new(color.red, 92)
            f_tpsl_row(bt_tbl, 17, tpsl_lbl + " S Put", tpsl_p_s_tot, tpsl_p_s_win, tpsl_p_s_tp, tpsl_p_s_sl, tpsl_p_s_ret, bg_p)
            f_tpsl_row(bt_tbl, 18, tpsl_lbl + " A Put", tpsl_p_a_tot, tpsl_p_a_win, tpsl_p_a_tp, tpsl_p_a_sl, tpsl_p_a_ret, bg_p)
            f_tpsl_row(bt_tbl, 19, tpsl_lbl + " B Put", tpsl_p_b_tot, tpsl_p_b_win, tpsl_p_b_tp, tpsl_p_b_sl, tpsl_p_b_ret, bg_p)
            // TP/SL Put Total summary
            f_tpsl_row(bt_tbl, 20, "► " + tpsl_lbl + " PUT", tpsl_put_total, tpsl_put_wins, tpsl_put_tp, tpsl_put_sl, tpsl_put_ret, color.new(color.red, 80))

            // TP/SL OVERALL summary with profit factor
            tpsl_wr_all = tpsl_total > 0 ? (tpsl_wins / math.max(1, tpsl_total)) * 100 : 0.0
            tpsl_avg_all = tpsl_total > 0 ? tpsl_sum_ret * 100 / math.max(1, tpsl_total) : 0.0
            // Profit factor: gross wins / gross losses across all tiers
            tpsl_gw = 0.0
            tpsl_gl = 0.0
            for _ret in array.from(tpsl_c_s_ret, tpsl_c_a_ret, tpsl_c_b_ret, tpsl_p_s_ret, tpsl_p_a_ret, tpsl_p_b_ret)
                if _ret > 0
                    tpsl_gw += _ret
                else
                    tpsl_gl += math.abs(_ret)
            pf = tpsl_gl > 0 ? tpsl_gw / tpsl_gl : 0.0
            pf_color = pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red
            bg_all = color.new(color.blue, 80)
            table.cell(bt_tbl, 0, 21, "► " + tpsl_lbl + " TOTAL",                                       text_color=color.white,                            text_size=size.small, text_halign=text.align_left, bgcolor=bg_all)
            table.cell(bt_tbl, 1, 21, str.tostring(tpsl_total),                                          text_color=color.white,                            text_size=size.small, bgcolor=bg_all)
            table.cell(bt_tbl, 2, 21, str.tostring(math.round(tpsl_wr_all, 1)) + "%",                    text_color=tpsl_wr_all >= 55 ? color.lime : color.white, text_size=size.small, bgcolor=bg_all)
            table.cell(bt_tbl, 3, 21, (tpsl_avg_all >= 0 ? "+" : "") + str.tostring(math.round(tpsl_avg_all, 2)) + "%", text_color=tpsl_avg_all >= 0 ? color.lime : color.red, text_size=size.small, bgcolor=bg_all)
            table.cell(bt_tbl, 4, 21, "TP:" + str.tostring(tpsl_tp_hits),                                text_color=color.lime,                             text_size=size.small, bgcolor=bg_all)
            table.cell(bt_tbl, 5, 21, "SL:" + str.tostring(tpsl_sl_hits),                                text_color=color.red,                              text_size=size.small, bgcolor=bg_all)
            table.cell(bt_tbl, 6, 21, "PF:" + str.tostring(math.round(pf, 2)),                           text_color=pf_color,                               text_size=size.small, bgcolor=bg_all)
            table.merge_cells(bt_tbl, 7, 21, 10, 21)
            table.cell(bt_tbl, 7, 21, "", bgcolor=bg_all)
            table.merge_cells(bt_tbl, 0, 21, 1, 21)

        if setup_filt_bt != "All"
            f_draw_bt_row(bt_tbl, 22, setup_filt_bt, t_filt, c7_filt, s7_filt, sum_m7_filt, a7_filt, c14_filt, s14_filt, sum_m14_filt, a14_filt, c30_filt, s30_filt, sum_m30_filt, a30_filt)
