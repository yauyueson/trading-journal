{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/option-price",
      "destination": "/api/option-prices"
    },
    {
      "source": "/api/option-prices-bulk",
      "destination": "/api/option-prices"
    },
    {
      "source": "/((?!api/)(?!assets/)(?!src/)(?!node_modules/)(?!@).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/option-prices.js": {
      "maxDuration": 15
    },
    "api/earnings.js": {
      "maxDuration": 10
    },
    "api/scan-options.js": {
      "maxDuration": 15
    },
    "api/strategy-recommend.js": {
      "maxDuration": 15
    },
    "api/check-alerts.js": {
      "maxDuration": 60
    },
"api/daily-recap.js": {
      "maxDuration": 60
    },
    "api/batch-refresh-tech.js": {
      "maxDuration": 25
    },
    "api/cron-signal-scan.js": {
      "maxDuration": 60
    },
    "api/backtest-iv.js": {
      "maxDuration": 15
    },
    "api/cron-trade-outcomes.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/daily-recap",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron-signal-scan",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/cron-trade-outcomes",
      "schedule": "35 21 * * 1-5"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        }
      ]
    }
  ]
}