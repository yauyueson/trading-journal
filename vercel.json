{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/option-price",
      "destination": "/api/option-prices"
    },
    {
      "source": "/api/option-prices-bulk",
      "destination": "/api/option-prices"
    },
    {
      "source": "/((?!api/)(?!assets/)(?!src/)(?!node_modules/)(?!@).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/option-prices.js": { "maxDuration": 15 },
    "api/earnings.js": { "maxDuration": 10 },
    "api/scan-options.js": { "maxDuration": 15 },
    "api/strategy-recommend.js": { "maxDuration": 15 },
    "api/check-alerts.js": { "maxDuration": 60 },
    "api/daily-recap.js": { "maxDuration": 60 },
    "api/backtest-data.js": { "maxDuration": 15 },
    "api/paper-autopilot.js": { "maxDuration": 60 },
    "api/cron-trade-outcomes.js": { "maxDuration": 30 },
    "api/cron-iv.js": { "maxDuration": 120 }
  },
  "crons": [
    {
      "path": "/api/cron-iv?job=backfill",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/paper-autopilot",
      "schedule": "0 15 * * 1-5"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ]
}
